</section>

<script>
  const initAnimations = () => {

    // =========================
    // Custom Cursor
    // =========================
    const cursor = document.getElementById('custom-cursor');
    const cursorDot = cursor?.querySelector<HTMLElement>('.cursorDot');
    const cursorRing = cursor?.querySelector<HTMLElement>('.cursorRing');

    let cursorX = 0, cursorY = 0;
    let dotX = 0, dotY = 0;
    let ringX = 0, ringY = 0;

    const updateCursor = () => {
      const dotSpeed = 0.35;
      const ringSpeed = 0.15;

      dotX += (cursorX - dotX) * dotSpeed;
      dotY += (cursorY - dotY) * dotSpeed;
      ringX += (cursorX - ringX) * ringSpeed;
      ringY += (cursorY - ringY) * ringSpeed;

      if (cursorDot && cursorRing) {
        cursorDot.style.transform = `translate(${dotX}px, ${dotY}px) translate(-50%, -50%)`;
        cursorRing.style.transform = `translate(${ringX}px, ${ringY}px) translate(-50%, -50%)`;
      }

      requestAnimationFrame(updateCursor);
    };

    if (window.matchMedia('(hover: hover)').matches && cursor) {
      document.addEventListener('mousemove', (e) => {
        cursorX = e.clientX;
        cursorY = e.clientY;
      });

      updateCursor();
    }

    // =========================
    // Intersection Observer
    // =========================
    const observerOptions = {
      root: null,
      rootMargin: '0px 0px -10% 0px',
      threshold: 0.1
    };

    const revealObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const delay = parseInt(entry.target.getAttribute('data-delay') || '0');
          setTimeout(() => {
            entry.target.classList.add('is-visible');
          }, delay);
          revealObserver.unobserve(entry.target);
        }
      });
    }, observerOptions);

    document
      .querySelectorAll<HTMLElement>('.js-fade-up, .js-reveal, .js-line-reveal, .js-split-lines')
      .forEach((el) => {
        revealObserver.observe(el);
      });

    // =========================
    // 🔥 スライダー（型安全版）
    // =========================
    const sliderTrack = document.querySelector<HTMLElement>('#slider-track');
    const slides = document.querySelectorAll<HTMLElement>('#slider-track > article');
    const prevBtn = document.getElementById('slider-prev') as HTMLButtonElement | null;
    const nextBtn = document.getElementById('slider-next') as HTMLButtonElement | null;
    const dots = document.querySelectorAll<HTMLElement>('[data-dot]');

    if (!sliderTrack || slides.length === 0) return;

    let current = 0;
    const total = slides.length;

    const updateSlider = () => {
      sliderTrack.style.transform = `translateX(-${current * 100}%)`;

      dots.forEach((dot, i) => {
        dot.classList.toggle('is-active', i === current);
      });
    };

    const next = () => {
      current = (current + 1) % total;
      updateSlider();
    };

    const prev = () => {
      current = (current - 1 + total) % total;
      updateSlider();
    };

    prevBtn?.addEventListener('click', prev);
    nextBtn?.addEventListener('click', next);

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        current = i;
        updateSlider();
      });
    });

    // autoplay
    let auto = setInterval(next, 6000);

    sliderTrack.addEventListener('mouseenter', () => clearInterval(auto));
    sliderTrack.addEventListener('mouseleave', () => {
      auto = setInterval(next, 6000);
    });

    updateSlider();

    // =========================
    // scroll cue
    // =========================
    const scrollCue = document.getElementById('scroll-cue');

    window.addEventListener('scroll', () => {
      if (scrollCue instanceof HTMLElement) {
        scrollCue.style.opacity = window.scrollY > 100 ? '0' : '1';
      }
    });
  };

  document.addEventListener('astro:page-load', initAnimations);
  document.addEventListener('DOMContentLoaded', initAnimations);
</script>
