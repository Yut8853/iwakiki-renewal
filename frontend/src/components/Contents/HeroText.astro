---
import styles from './HeroText.module.scss';
---

<section class={styles.about} aria-labelledby="about-title">
  <div class={styles.videoBg} id="hover-video-container">
    <div class={styles.videoOverlay}></div>
    <video id="hover-video" muted loop playsinline>
      <source src="/videos/section01.mp4" type="video/mp4" />
    </video>
  </div>

  <div class={styles.inner}>
    <header class={`${styles.header} js-observe`}>
      <p class={styles.eyebrow}>幸せを感じる不動産との縁結び</p>
      <h1 id="about-title" class={styles.title}>
        福島県いわき市を中心に<br />
        皆さまの夢の実現をお手伝いします。
      </h1>
      <p class={styles.lead}>
        お客様一人ひとりのニーズに合わせて最適な物件をご紹介し、
        心から満足いただける住まいを目指します。
      </p>
    </header>

    <section class={`${styles.section} js-observe`} aria-labelledby="about-promise">
      <h2 id="about-promise" class={styles.heading}>
        あなたの幸せを第一に。誠実なサポートをお約束します。
      </h2>
      <div class={styles.body}>
        <p class={styles.text}>
          家族の未来を見据えた、安全で快適な生活環境を一緒に見つけませんか。
        </p>
        <p class={styles.text}>
          お客様とのご縁を大切にし、末永いお付き合いを目指して丁寧に伴走します。
        </p>
      </div>
    </section>

    <section class={`${styles.section} js-observe`} aria-labelledby="about-strengths">
      <h2 id="about-strengths" class={styles.heading}>私たちが大切にしていること</h2>
      <ul class={styles.list}>
        <li class={`${styles.item} js-observe js-video-trigger delay-1`}>
          <strong class={styles.key}>ご要望の深掘り：</strong>
          暮らし方・将来設計まで伺い、条件の優先順位を一緒に整理します。
        </li>
        <li class={`${styles.item} js-observe delay-2`}>
          <strong class={styles.key}>納得できる提案：</strong>
          物件の良い点だけでなく、気になる点も含めて分かりやすくお伝えします。
        </li>
        <li class={`${styles.item} js-observe delay-3`}>
          <strong class={styles.key}>長いお付き合い：</strong>
          ご購入後・ご入居後も、困ったときに気軽に頼れる存在でありたいと考えています。
        </li>
      </ul>
    </section>

    <section class={`${styles.section} js-observe`} aria-labelledby="about-story">
      <h2 id="about-story" class={styles.heading}>これまでと、これから</h2>
      <div class={styles.body}>
        <p class={styles.text2}>
          埼玉県で生まれ育ち、28歳で東京の不動産の門を叩きました。<br>
          不動産業・測量業を合わせて約22年間、多くのお客様を支援してきました。
        </p>
        <p class={styles.text2}>
          多くのご縁に恵まれ、真心を込めたサービスを信念としております。
        </p>
        <p class={styles.text2}>
          これまでの経験を活かし、今後も東京での総合不動産業と、いわき市の活性化やＵＩＪターン(移住者)・関東への移住の架け橋、高齢者サポートを通し、地域の皆様の暮らしが豊かになるようにお手伝いをさせていただきたいと考えております。<br><br>
          これから皆様に気軽にお声をかけていただける会社を目指し、努めてまいります。
        </p>
      </div>
    </section>

    <section class={`${styles.cta} js-observe`} aria-label="お問い合わせ">
      <p class={styles.ctaText}>
        住まい探し・ご相談は、お気軽にお問い合わせください。
      </p>
      <div class={styles.ctaButtons}>
        <button class={`${styles.contactButton} ${styles.slide}`}>
          お問い合わせ
        </button>
        <button class={`${styles.contactButton} ${styles.slide}`}>
          物件を見る
        </button>
      </div>
    </section>
  </div>
</section>

<script>
  const setupEffects = () => {
    // 1. スクロール監視
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { rootMargin: '0px 0px -15% 0px', threshold: 0.1 }
    );
    document.querySelectorAll('.js-observe').forEach((el) => observer.observe(el));

    // 2. ホバー動画制御
    const videoContainer = document.getElementById('hover-video-container');
    const videoElement = document.getElementById('hover-video');
    const triggers = document.querySelectorAll('.js-video-trigger');

    triggers.forEach(trigger => {
      trigger.addEventListener('mouseenter', () => {
        if (videoContainer && videoElement) {
          // CSS Modulesのクラス名をJSから直接参照できないため、classList.addで制御
          // (SCSS側で .videoBg.isActive として定義)
          videoContainer.style.opacity = '1';
          videoContainer.style.visibility = 'visible';
          videoElement.play();
        }
      });
      trigger.addEventListener('mouseleave', () => {
        if (videoContainer && videoElement) {
          videoContainer.style.opacity = '0';
          videoContainer.style.visibility = 'hidden';
          videoElement.pause();
        }
      });
    });
  };

  document.addEventListener('astro:page-load', setupEffects);
  document.addEventListener('DOMContentLoaded', setupEffects);
</script>