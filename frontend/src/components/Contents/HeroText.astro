---
import styles from './HeroText.module.scss';
---

<!-- Custom Cursor -->
<div class={styles.cursor} id="custom-cursor">
  <div class={styles.cursorDot}></div>
  <div class={styles.cursorRing}></div>
  <div class={styles.cursorTrail}></div>
</div>

<!-- Hero Section -->
<section class={styles.hero} data-scroll-section>
  <div class={styles.heroBg}>
    <div class={styles.heroGrid}></div>
    <div class={styles.heroGradient}></div>
    <div class={styles.heroOrb} data-orb="1"></div>
    <div class={styles.heroOrb} data-orb="2"></div>
  </div>
  
  <div class={styles.heroContent}>
    <div class={styles.heroMain}>
      <div class={styles.heroLabel}>
        <span class={styles.labelLine}></span>
        <span class={`${styles.labelText} js-char-split`}>FUKUENISHI REAL ESTATE</span>
        <span class={styles.labelLine}></span>
      </div>
      
      <h1 class={styles.heroTitle}>
        <span class={`${styles.titleLine} js-line-reveal`} data-delay="0">
          <span class={styles.titleInner}>幸せを感じる</span>
        </span>
        <span class={`${styles.titleLine} js-line-reveal`} data-delay="100">
          <span class={styles.titleInner}>不動産との</span>
        </span>
        <span class={`${styles.titleLine} ${styles.titleAccent} js-line-reveal`} data-delay="200">
          <span class={styles.titleInner}>縁結び</span>
          <svg class={styles.titleUnderline} viewBox="0 0 300 20" preserveAspectRatio="none">
            <path d="M0,10 Q75,0 150,10 T300,10" fill="none" stroke="currentColor" stroke-width="3"/>
          </svg>
        </span>
      </h1>
      
      <p class={`${styles.heroLead} js-fade-up`} data-delay="400">
        福島県いわき市を中心に、皆さまの夢の実現をお手伝いします。<br />
        お客様一人ひとりのニーズに合わせた最適な物件をご紹介。
      </p>
      
      <div class={`${styles.heroCta} js-fade-up`} data-delay="600">
        <a href="#contact" class={styles.ctaPrimary} data-magnetic>
          <span class={styles.ctaText}>お問い合わせ</span>
          <span class={styles.ctaIcon}>
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
          <span class={styles.ctaGlow}></span>
        </a>
        <a href="#properties" class={styles.ctaSecondary} data-magnetic>
          <span>物件を探す</span>
        </a>
      </div>
      
      <div class={`${styles.heroStats} js-fade-up`} data-delay="800">
        <div class={styles.statItem}>
          <span class={styles.statNumber} data-count="22">0</span>
          <span class={styles.statUnit}>年</span>
          <span class={styles.statLabel}>の実績</span>
        </div>
        <div class={styles.statDivider}></div>
        <div class={styles.statItem}>
          <span class={styles.statNumber} data-count="2200">0</span>
          <span class={styles.statUnit}>+</span>
          <span class={styles.statLabel}>取扱物件</span>
        </div>
        <div class={styles.statDivider}></div>
        <div class={styles.statItem}>
          <span class={styles.statNumber} data-count="98">0</span>
          <span class={styles.statUnit}>%</span>
          <span class={styles.statLabel}>満足度</span>
        </div>
      </div>
    </div>
    
    <div class={styles.heroVisual}>
      <div class={styles.visualFrame}>
        <div class={styles.visualClip}>
          <video class={styles.heroVideo} id="hero-video" muted loop playsinline autoplay>
            <source src="/videos/section01.mp4" type="video/mp4" />
          </video>
          <div class={styles.visualOverlay}></div>
        </div>
        <div class={styles.visualBorder}></div>
        <div class={styles.visualCorner} data-corner="tl"></div>
        <div class={styles.visualCorner} data-corner="tr"></div>
        <div class={styles.visualCorner} data-corner="bl"></div>
        <div class={styles.visualCorner} data-corner="br"></div>
      </div>
      <div class={styles.visualFloat}>
        <div class={styles.floatCard}>
          <div class={styles.floatIcon}>
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" stroke="currentColor" stroke-width="1.5"/>
              <path d="M9 22V12h6v10" stroke="currentColor" stroke-width="1.5"/>
            </svg>
          </div>
          <div class={styles.floatText}>
            <span class={styles.floatLabel}>今月の成約</span>
            <span class={styles.floatValue}>+24件</span>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <div class={styles.scrollCue} id="scroll-cue">
    <span class={styles.scrollText}>Scroll</span>
    <div class={styles.scrollTrack}>
      <div class={styles.scrollThumb}></div>
    </div>
  </div>
</section>

<!-- About Section -->
<section class={styles.about} data-scroll-section id="about">
  <div class={styles.aboutBg}>
    <div class={styles.aboutPattern}></div>
  </div>
  
  <div class={styles.container}>
    <div class={styles.sectionHeader}>
      <div class={styles.sectionLabel}>
        <span class={styles.labelNum}>01</span>
        <span class={styles.labelDash}></span>
        <span class={styles.labelName}>ABOUT US</span>
      </div>
      <h2 class={`${styles.sectionTitle} js-split-lines`}>
        あなたの幸せを第一に。<br />
        誠実なサポートをお約束します。
      </h2>
      <p class={`${styles.sectionLead} js-fade-up`}>
        家族の未来を見据えた、安全で快適な生活環境を一緒に見つけませんか。
        お客様とのご縁を大切にし、末永いお付き合いを目指して丁寧に伴走します。
      </p>
    </div>
    
    <div class={styles.valueCards}>
      <article class={`${styles.valueCard} js-tilt`} data-card="1">
        <div class={styles.cardGlow}></div>
        <div class={styles.cardContent}>
          <span class={styles.cardNum}>01</span>
          <div class={styles.cardIcon}>
            <svg viewBox="0 0 64 64" fill="none">
              <circle cx="32" cy="32" r="28" stroke="currentColor" stroke-width="1.5"/>
              <circle cx="32" cy="32" r="12" stroke="currentColor" stroke-width="1.5"/>
              <circle cx="32" cy="32" r="4" fill="currentColor"/>
              <path d="M32 4v8M32 52v8M4 32h8M52 32h8" stroke="currentColor" stroke-width="1.5"/>
            </svg>
          </div>
          <h3 class={styles.cardTitle}>ご要望の深掘り</h3>
          <p class={styles.cardDesc}>
            暮らし方・将来設計まで伺い、条件の優先順位を一緒に整理します。
            表面的なヒアリングではなく、本質的なニーズを探ります。
          </p>
          <ul class={styles.cardFeatures}>
            <li>ライフスタイル診断</li>
            <li>将来設計ヒアリング</li>
            <li>優先順位の可視化</li>
          </ul>
        </div>
      </article>
      
      <article class={`${styles.valueCard} js-tilt`} data-card="2">
        <div class={styles.cardGlow}></div>
        <div class={styles.cardContent}>
          <span class={styles.cardNum}>02</span>
          <div class={styles.cardIcon}>
            <svg viewBox="0 0 64 64" fill="none">
              <rect x="8" y="16" width="48" height="40" rx="4" stroke="currentColor" stroke-width="1.5"/>
              <path d="M8 28h48" stroke="currentColor" stroke-width="1.5"/>
              <circle cx="20" cy="22" r="2" fill="currentColor"/>
              <circle cx="28" cy="22" r="2" fill="currentColor"/>
              <circle cx="36" cy="22" r="2" fill="currentColor"/>
              <path d="M20 40l8 8 16-16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <h3 class={styles.cardTitle}>納得できる提案</h3>
          <p class={styles.cardDesc}>
            物件の良い点だけでなく、気になる点も含めて分かりやすくお伝えします。
            透明性のある情報提供を心がけています。
          </p>
          <ul class={styles.cardFeatures}>
            <li>メリット・デメリット開示</li>
            <li>市場価格の透明化</li>
            <li>リスク要因の説明</li>
          </ul>
        </div>
      </article>
      
      <article class={`${styles.valueCard} js-tilt`} data-card="3">
        <div class={styles.cardGlow}></div>
        <div class={styles.cardContent}>
          <span class={styles.cardNum}>03</span>
          <div class={styles.cardIcon}>
            <svg viewBox="0 0 64 64" fill="none">
              <path d="M32 8c13.255 0 24 10.745 24 24S45.255 56 32 56 8 45.255 8 32" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              <path d="M32 20v14l10 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <circle cx="32" cy="32" r="3" fill="currentColor"/>
            </svg>
          </div>
          <h3 class={styles.cardTitle}>長いお付き合い</h3>
          <p class={styles.cardDesc}>
            ご購入後・ご入居後も、困ったときに気軽に頼れる存在でありたいと考えています。
            アフターフォローを大切にしています。
          </p>
          <ul class={styles.cardFeatures}>
            <li>定期フォローアップ</li>
            <li>メンテナンス相談</li>
            <li>資産運用アドバイス</li>
          </ul>
        </div>
      </article>
    </div>
  </div>
</section>

<!-- Services Section -->
<section class={styles.services} data-scroll-section id="services">
  <div class={styles.container}>
    <div class={styles.sectionHeader}>
      <div class={styles.sectionLabel}>
        <span class={styles.labelNum}>02</span>
        <span class={styles.labelDash}></span>
        <span class={styles.labelName}>SERVICES</span>
      </div>
      <h2 class={`${styles.sectionTitle} js-split-lines`}>
        サービス内容
      </h2>
    </div>
    
    <div class={styles.servicesMarquee}>
      <div class={styles.marqueeInner} id="marquee-track">
        <div class={styles.marqueeItem}><span>売買仲介</span></div>
        <div class={styles.marqueeItem}><span>賃貸仲介</span></div>
        <div class={styles.marqueeItem}><span>物件管理</span></div>
        <div class={styles.marqueeItem}><span>測量業務</span></div>
        <div class={styles.marqueeItem}><span>投資相談</span></div>
        <div class={styles.marqueeItem}><span>リノベーション</span></div>
        <div class={styles.marqueeItem}><span>売買仲介</span></div>
        <div class={styles.marqueeItem}><span>賃貸仲介</span></div>
        <div class={styles.marqueeItem}><span>物件管理</span></div>
        <div class={styles.marqueeItem}><span>測量業務</span></div>
        <div class={styles.marqueeItem}><span>投資相談</span></div>
        <div class={styles.marqueeItem}><span>リノベーション</span></div>
      </div>
    </div>
    
    <div class={styles.servicesGrid}>
      <article class={`${styles.serviceCard} js-reveal`} data-service="sale">
        <div class={styles.serviceVisual}>
          <div class={styles.serviceIcon}>
            <svg viewBox="0 0 80 80" fill="none">
              <path d="M40 8L8 32v40h64V32L40 8z" stroke="currentColor" stroke-width="2"/>
              <path d="M28 72V48h24v24" stroke="currentColor" stroke-width="2"/>
              <path d="M48 56h8" stroke="currentColor" stroke-width="2"/>
              <circle cx="56" cy="24" r="8" stroke="currentColor" stroke-width="2"/>
              <path d="M56 20v8M52 24h8" stroke="currentColor" stroke-width="2"/>
            </svg>
          </div>
          <div class={styles.serviceBg}></div>
        </div>
        <div class={styles.serviceBody}>
          <h3>売買仲介</h3>
          <p>お客様のライフプランに合わせた物件探しから、契約・引き渡しまでトータルサポート。住宅ローンのご相談も承ります。</p>
          <a href="/services#sale" class={styles.serviceLink}>
            <span>詳しく見る</span>
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2"/>
            </svg>
          </a>
        </div>
      </article>
      
      <article class={`${styles.serviceCard} js-reveal`} data-service="rent">
        <div class={styles.serviceVisual}>
          <div class={styles.serviceIcon}>
            <svg viewBox="0 0 80 80" fill="none">
              <rect x="12" y="20" width="56" height="48" rx="4" stroke="currentColor" stroke-width="2"/>
              <path d="M12 36h56" stroke="currentColor" stroke-width="2"/>
              <circle cx="40" cy="52" r="8" stroke="currentColor" stroke-width="2"/>
              <path d="M40 48v8" stroke="currentColor" stroke-width="2"/>
              <path d="M24 28h8M48 28h8" stroke="currentColor" stroke-width="2"/>
            </svg>
          </div>
          <div class={styles.serviceBg}></div>
        </div>
        <div class={styles.serviceBody}>
          <h3>賃貸仲介</h3>
          <p>単身からファミリー向けまで、豊富な物件をご用意。入居審査から鍵のお渡しまでスムーズに対応いたします。</p>
          <a href="/services#rent" class={styles.serviceLink}>
            <span>詳しく見る</span>
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2"/>
            </svg>
          </a>
        </div>
      </article>
      
      <article class={`${styles.serviceCard} js-reveal`} data-service="manage">
        <div class={styles.serviceVisual}>
          <div class={styles.serviceIcon}>
            <svg viewBox="0 0 80 80" fill="none">
              <circle cx="40" cy="40" r="28" stroke="currentColor" stroke-width="2"/>
              <path d="M40 20v20l14 8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              <circle cx="40" cy="40" r="4" fill="currentColor"/>
              <path d="M40 8v4M40 68v4M8 40h4M68 40h4" stroke="currentColor" stroke-width="2"/>
            </svg>
          </div>
          <div class={styles.serviceBg}></div>
        </div>
        <div class={styles.serviceBody}>
          <h3>物件管理</h3>
          <p>オーナー様の大切な資産を責任を持って管理。入居者対応から建物メンテナンスまで一括でお任せください。</p>
          <a href="/services#management" class={styles.serviceLink}>
            <span>詳しく見る</span>
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2"/>
            </svg>
          </a>
        </div>
      </article>
    </div>
  </div>
</section>

<!-- Story Section -->
<section class={styles.story} data-scroll-section id="story">
  <div class={styles.storyBg}>
    <div class={styles.storyGrain}></div>
    <div class={styles.storyGlow}></div>
  </div>
  
  <div class={styles.container}>
    <div class={styles.storyLayout}>
      <div class={styles.storyContent}>
        <div class={styles.sectionLabel}>
          <span class={styles.labelNum}>03</span>
          <span class={styles.labelDash}></span>
          <span class={styles.labelName}>OUR STORY</span>
        </div>
        <h2 class={`${styles.sectionTitle} ${styles.storyTitle} js-split-lines`}>
          これまでと、これから
        </h2>
        <div class={`${styles.storyText} js-fade-up`}>
          <p>
            埼玉県で生まれ育ち、28歳で東京の不動産の門を叩きました。
            不動産業・測量業を合わせて約22年間、多くのお客様を支援してきました。
          </p>
          <p>
            多くのご縁に恵まれ、真心を込めたサービスを信念としております。
          </p>
          <p>
            これまでの経験を活かし、今後も東京での総合不動産業と、
            いわき市の活性化やＵＩＪターン(移住者)・関東への移住の架け橋、
            高齢者サポートを通し、地域の皆様の暮らしが豊かになるようにお手伝いをさせていただきたいと考えております。
          </p>
          <blockquote class={styles.storyQuote}>
            これから皆様に気軽にお声をか��ていただける会社を目指し、努めてまいります。
          </blockquote>
        </div>
      </div>
      
      <div class={styles.storyTimeline}>
        <div class={styles.timelineLine}></div>
        <div class={`${styles.timelineItem} js-reveal`} data-year="1995">
          <span class={styles.timelineDot}></span>
          <div class={styles.timelineContent}>
            <span class={styles.timelineYear}>1995</span>
            <span class={styles.timelineEvent}>不動産業界へ</span>
          </div>
        </div>
        <div class={`${styles.timelineItem} js-reveal`} data-year="2005">
          <span class={styles.timelineDot}></span>
          <div class={styles.timelineContent}>
            <span class={styles.timelineYear}>2005</span>
            <span class={styles.timelineEvent}>測量業を併設</span>
          </div>
        </div>
        <div class={`${styles.timelineItem} js-reveal`} data-year="2015">
          <span class={styles.timelineDot}></span>
          <div class={styles.timelineContent}>
            <span class={styles.timelineYear}>2015</span>
            <span class={styles.timelineEvent}>いわき市進出</span>
          </div>
        </div>
        <div class={`${styles.timelineItem} js-reveal`} data-year="2024">
          <span class={styles.timelineDot}></span>
          <div class={styles.timelineContent}>
            <span class={styles.timelineYear}>2024</span>
            <span class={styles.timelineEvent}>新たな挑戦へ</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Testimonials Section -->
<section class={styles.testimonials} data-scroll-section id="voice">
  <div class={styles.container}>
    <div class={styles.sectionHeader}>
      <div class={styles.sectionLabel}>
        <span class={styles.labelNum}>04</span>
        <span class={styles.labelDash}></span>
        <span class={styles.labelName}>VOICE</span>
      </div>
      <h2 class={`${styles.sectionTitle} js-split-lines`}>
        お客様の声
      </h2>
    </div>
    
    <div class={styles.testimonialSlider} id="testimonial-slider">
      <div class={styles.sliderTrack} id="slider-track">
        <article class={styles.testimonialCard}>
          <div class={styles.quoteIcon}>
            <svg viewBox="0 0 40 40" fill="currentColor">
              <path d="M10 25h6l4-8v-8H8v8h6l-4 8zm16 0h6l4-8v-8h-12v8h6l-4 8z"/>
            </svg>
          </div>
          <p class={styles.quoteText}>
            初めての不動産購入で不安でしたが、担当の方が親身になって相談に乗ってくださいました。
            おかげで理想の住まいに出会えました。
          </p>
          <div class={styles.quoteAuthor}>
            <div class={styles.authorAvatar}>S.T</div>
            <div class={styles.authorInfo}>
              <span class={styles.authorName}>S.T様</span>
              <span class={styles.authorMeta}>30代 / 戸建て購入</span>
            </div>
          </div>
        </article>
        
        <article class={styles.testimonialCard}>
          <div class={styles.quoteIcon}>
            <svg viewBox="0 0 40 40" fill="currentColor">
              <path d="M10 25h6l4-8v-8H8v8h6l-4 8zm16 0h6l4-8v-8h-12v8h6l-4 8z"/>
            </svg>
          </div>
          <p class={styles.quoteText}>
            東京からいわき市への移住を検討していましたが、地域の情報も詳しく教えていただき、
            安心して新生活をスタートできました。
          </p>
          <div class={styles.quoteAuthor}>
            <div class={styles.authorAvatar}>K.M</div>
            <div class={styles.authorInfo}>
              <span class={styles.authorName}>K.M様</span>
              <span class={styles.authorMeta}>40代 / UIターン</span>
            </div>
          </div>
        </article>
        
        <article class={styles.testimonialCard}>
          <div class={styles.quoteIcon}>
            <svg viewBox="0 0 40 40" fill="currentColor">
              <path d="M10 25h6l4-8v-8H8v8h6l-4 8zm16 0h6l4-8v-8h-12v8h6l-4 8z"/>
            </svg>
          </div>
          <p class={styles.quoteText}>
            物件管理をお願いしていますが、入居者対応も迅速で安心してお任せできています。
            定期的な報告もあり、信頼しています。
          </p>
          <div class={styles.quoteAuthor}>
            <div class={styles.authorAvatar}>Y.A</div>
            <div class={styles.authorInfo}>
              <span class={styles.authorName}>Y.A様</span>
              <span class={styles.authorMeta}>50代 / 物件オーナー</span>
            </div>
          </div>
        </article>
      </div>
      
      <div class={styles.sliderControls}>
        <button class={styles.sliderBtn} id="slider-prev" aria-label="前へ">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M19 12H5M12 19l-7-7 7-7" stroke="currentColor" stroke-width="2"/>
          </svg>
        </button>
<div class={styles.sliderDots} id="slider-dots">
  <button class={styles.dot} data-dot></button>
  <button class={styles.dot} data-dot></button>
  <button class={styles.dot} data-dot></button>
</div>
        <button class={styles.sliderBtn} id="slider-next" aria-label="次へ">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2"/>
          </svg>
        </button>
      </div>
    </div>
  </div>
</section>

<!-- CTA Section -->
<section class={styles.cta} data-scroll-section id="contact">
  <div class={styles.ctaBg}>
    <div class={styles.ctaPattern}></div>
    <div class={styles.ctaGlow}></div>
  </div>
  
  <div class={styles.container}>
    <div class={`${styles.ctaContent} js-fade-up`}>
      <h2 class={styles.ctaTitle}>
        住まい探しのパートナーとして、<br />
        あなたの夢を叶えます。
      </h2>
      <p class={styles.ctaLead}>
        ご相談・お問い合わせはお気軽にどうぞ。<br />
        専門スタッフが丁寧に対応いたします。
      </p>
      
      <div class={styles.ctaActions}>
        <a href="tel:0246-00-0000" class={styles.ctaPhone} data-magnetic>
          <span class={styles.phoneIcon}>
            <svg viewBox="0 0 24 24" fill="none">
