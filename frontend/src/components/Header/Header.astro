---
const navItems = [
  { href: '/about', label: 'About', labelJp: '私たちについて' },
  { href: '/blog', label: 'Blog', labelJp: 'ブログ' },
];
---

<header class="header" data-header>
  <div class="header__inner">
    <!-- Logo -->
    <a href="/" class="header__logo" data-logo>
      <span class="header__logo-text">
        <img src="images/logo.png" alt="" srcset="">
      </span>
      <span class="header__logo-tagline">vacation homes</span>
    </a>

    <!-- Navigation -->
    <nav class="header__nav" data-nav>
      <ul class="header__nav-list">
        {navItems.map((item, index) => (
          <li class="header__nav-item" style={`--item-index: ${index}`}>
            <a href={item.href} class="header__nav-link" data-nav-link>
              <span class="header__nav-label">{item.label}</span>
              <span class="header__nav-label-jp">{item.labelJp}</span>
              <span class="header__nav-line"></span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Actions -->
    <div class="header__actions">
      <a href="tel:0246-00-0000" class="header__phone" data-phone>
        <svg class="header__phone-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/>
        </svg>
        <span class="header__phone-number">0246-00-0000</span>
      </a>

      <a href="/contact" class="header__cta" data-cta>
        <span class="header__cta-text">お問い合わせ</span>
        <span class="header__cta-arrow">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </span>
      </a>

      <a href="https://instagram.com/iwakiki" target="_blank" rel="noopener" class="header__social" data-social aria-label="Instagram">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <rect x="2" y="2" width="20" height="20" rx="5"/>
          <circle cx="12" cy="12" r="4"/>
          <circle cx="18" cy="6" r="1" fill="currentColor"/>
        </svg>
      </a>

      <!-- Mobile Menu Toggle -->
      <button class="header__menu-toggle" data-menu-toggle aria-label="メニューを開く">
        <span class="header__menu-line"></span>
        <span class="header__menu-line"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div class="header__mobile-menu" data-mobile-menu>
    <div class="header__mobile-menu-inner">
      <nav class="header__mobile-nav">
        {navItems.map((item, index) => (
          <a href={item.href} class="header__mobile-link" style={`--item-index: ${index}`}>
            <span class="header__mobile-link-number">0{index + 1}</span>
            <span class="header__mobile-link-text">{item.label}</span>
            <span class="header__mobile-link-jp">{item.labelJp}</span>
          </a>
        ))}
        <a href="/contact" class="header__mobile-link" style="--item-index: 2">
          <span class="header__mobile-link-number">03</span>
          <span class="header__mobile-link-text">Contact</span>
          <span class="header__mobile-link-jp">お問い合わせ</span>
        </a>
      </nav>

      <div class="header__mobile-footer">
        <a href="tel:0246-00-0000" class="header__mobile-phone">
          <span>0246-00-0000</span>
        </a>
        <a href="https://instagram.com/iwakiki" target="_blank" rel="noopener" class="header__mobile-social">
          Instagram
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  :root {
  --color-cream: #f8f6f1;
  --color-cream-dark: #ebe8e0;
  --color-charcoal: #1a1a1a;
  --color-charcoal-light: #2d2d2d;
  --color-terracotta: #06756d;
  --color-sage: #06756d;
  --color-stone: #9a9590;
  
  --font-sans: 'Inter', system-ui, sans-serif;
  --font-serif: 'DM Serif Display', Georgia, serif;
  
  --ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);
  --ease-out-quart: cubic-bezier(0.25, 1, 0.5, 1);
}
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    padding: 0 clamp(1.5rem, 4vw, 3rem);
    transition: background-color 0.6s var(--ease-out-expo), 
                backdrop-filter 0.6s var(--ease-out-expo),
                padding 0.6s var(--ease-out-expo);
  }

  .header.is-scrolled {
    background-color: rgba(248, 246, 241, 0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: clamp(70px, 10vh, 100px);
    max-width: 1600px;
    margin: 0 auto;
  }

  /* Logo */
  .header__logo {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--color-charcoal);
    position: relative;
    overflow: hidden;
  }

  .header__logo-text {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    letter-spacing: -0.02em;
    line-height: 1;
    transform: translateY(0);
    transition: transform 0.5s var(--ease-out-expo);
  }

  .header__logo-tagline {
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-stone);
    margin-top: 0.15rem;
    transform: translateY(0);
    opacity: 1;
    transition: transform 0.5s var(--ease-out-expo), 
                opacity 0.4s var(--ease-out-expo);
  }

  .header__logo:hover .header__logo-text {
    transform: translateY(-2px);
  }

  .header__logo:hover .header__logo-tagline {
    transform: translateY(-2px);
    opacity: 0.7;
  }

  /* Navigation */
  .header__nav {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
  }

  .header__nav-list {
    display: flex;
    gap: clamp(2rem, 4vw, 4rem);
    list-style: none;
  }

  .header__nav-item {
    opacity: 0;
    animation: navItemIn 0.8s var(--ease-out-expo) forwards;
    animation-delay: calc(0.1s + var(--item-index) * 0.08s);
  }

  @keyframes navItemIn {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .header__nav-link {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    color: var(--color-charcoal);
    padding: 0.5rem 0;
  }

  .header__nav-label {
    font-size: 0.85rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: transform 0.4s var(--ease-out-expo);
  }

  .header__nav-label-jp {
    position: absolute;
    bottom: -0.2rem;
    font-size: 0.6rem;
    color: var(--color-stone);
    letter-spacing: 0.05em;
    opacity: 0;
    transform: translateY(5px);
    transition: opacity 0.4s var(--ease-out-expo), 
                transform 0.4s var(--ease-out-expo);
  }

  .header__nav-line {
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 0;
    height: 1px;
    background-color: var(--color-charcoal);
    transform: translateX(-50%);
    transition: width 0.5s var(--ease-out-expo);
  }

  .header__nav-link:hover .header__nav-label {
    transform: translateY(-3px);
  }

  .header__nav-link:hover .header__nav-label-jp {
    opacity: 1;
    transform: translateY(0);
  }

  .header__nav-link:hover .header__nav-line {
    width: 100%;
  }

  /* Actions */
  .header__actions {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2vw, 2rem);
  }

  .header__phone {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--color-charcoal);
    opacity: 0;
    animation: fadeIn 0.8s var(--ease-out-expo) 0.3s forwards;
  }

  @keyframes fadeIn {
    to { opacity: 1; }
  }

  .header__phone-icon {
    width: 18px;
    height: 18px;
    transition: transform 0.4s var(--ease-out-expo);
  }

  .header__phone-number {
    font-size: 0.85rem;
    font-weight: 400;
    letter-spacing: 0.05em;
    transition: color 0.3s ease;
  }

  .header__phone:hover .header__phone-icon {
    transform: rotate(-15deg) scale(1.1);
  }

  .header__phone:hover .header__phone-number {
    color: var(--color-terracotta);
  }

  /* CTA Button */
  .header__cta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1.5rem;
    background-color: var(--color-charcoal);
    color: var(--color-cream);
    text-decoration: none;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-radius: 100px;
    overflow: hidden;
    position: relative;
    opacity: 0;
    animation: fadeIn 0.8s var(--ease-out-expo) 0.4s forwards;
    transition: background-color 0.4s var(--ease-out-expo);
  }

  .header__cta::before {
    content: '';
    position: absolute;
    inset: 0;
    background-color: var(--color-terracotta);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s var(--ease-out-expo);
  }

  .header__cta:hover::before {
    transform: scaleX(1);
  }

  .header__cta-text {
    position: relative;
    z-index: 1;
  }

  .header__cta-arrow {
    position: relative;
    z-index: 1;
    width: 16px;
    height: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.4s var(--ease-out-expo);
  }

  .header__cta-arrow svg {
    width: 14px;
    height: 14px;
  }

  .header__cta:hover .header__cta-arrow {
    transform: translateX(4px);
  }

  /* Social */
  .header__social {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-charcoal);
    border: 1px solid var(--color-cream-dark);
    border-radius: 50%;
    transition: border-color 0.3s ease, 
                color 0.3s ease,
                transform 0.4s var(--ease-out-expo);
    opacity: 0;
    animation: fadeIn 0.8s var(--ease-out-expo) 0.5s forwards;
  }

  .header__social svg {
    width: 18px;
    height: 18px;
  }

  .header__social:hover {
    border-color: var(--color-charcoal);
    transform: scale(1.05);
  }

  /* Menu Toggle */
  .header__menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 6px;
    width: 44px;
    height: 44px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .header__menu-line {
    width: 24px;
    height: 1.5px;
    background-color: var(--color-charcoal);
    transition: transform 0.4s var(--ease-out-expo),
                opacity 0.3s ease;
  }

  .header__menu-toggle.is-active .header__menu-line:first-child {
    transform: rotate(45deg) translateY(5px);
  }

  .header__menu-toggle.is-active .header__menu-line:last-child {
    transform: rotate(-45deg) translateY(-5px);
  }

  /* Mobile Menu */
  .header__mobile-menu {
    position: fixed;
    inset: 0;
    background-color: var(--color-cream);
    z-index: -1;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.6s var(--ease-out-expo),
                visibility 0.6s;
  }

  .header__mobile-menu.is-open {
    opacity: 1;
    visibility: visible;
  }

  .header__mobile-menu-inner {
    display: flex;
    flex-direction: column;
    justify-content: center;
    height: 100%;
    padding: 120px clamp(2rem, 8vw, 6rem);
  }

  .header__mobile-nav {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .header__mobile-link {
    display: grid;
    grid-template-columns: 40px 1fr;
    grid-template-rows: auto auto;
    gap: 0 1rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--color-cream-dark);
    text-decoration: none;
    color: var(--color-charcoal);
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.6s var(--ease-out-expo),
                transform 0.6s var(--ease-out-expo);
    transition-delay: calc(var(--item-index) * 0.08s);
  }

  .header__mobile-menu.is-open .header__mobile-link {
    opacity: 1;
    transform: translateY(0);
  }

  .header__mobile-link-number {
    grid-row: 1 / 3;
    font-size: 0.7rem;
    color: var(--color-stone);
    font-weight: 300;
    align-self: center;
  }

  .header__mobile-link-text {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 6vw, 3.5rem);
    line-height: 1.1;
    transition: transform 0.4s var(--ease-out-expo);
  }

  .header__mobile-link-jp {
    font-size: 0.75rem;
    color: var(--color-stone);
    margin-top: 0.25rem;
  }

  .header__mobile-link:hover .header__mobile-link-text {
    transform: translateX(10px);
  }

  .header__mobile-footer {
    margin-top: auto;
    padding-top: 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s var(--ease-out-expo) 0.3s,
                transform 0.6s var(--ease-out-expo) 0.3s;
  }

  .header__mobile-menu.is-open .header__mobile-footer {
    opacity: 1;
    transform: translateY(0);
  }

  .header__mobile-phone,
  .header__mobile-social {
    font-size: 0.85rem;
    color: var(--color-charcoal);
    text-decoration: none;
    letter-spacing: 0.05em;
  }

  /* Responsive */
  @media (max-width: 900px) {
    .header__nav,
    .header__phone,
    .header__cta,
    .header__social {
      display: none;
    }

    .header__menu-toggle {
      display: flex;
    }
  }
</style>

<script>
  const header = document.querySelector('[data-header]') as HTMLElement;
  const menuToggle = document.querySelector('[data-menu-toggle]') as HTMLButtonElement;
  const mobileMenu = document.querySelector('[data-mobile-menu]') as HTMLElement;

  // Scroll behavior
  let lastScrollY = 0;
  let ticking = false;

  function updateHeader() {
    const scrollY = window.scrollY;

    if (scrollY > 50) {
      header.classList.add('is-scrolled');
    } else {
      header.classList.remove('is-scrolled');
    }

    lastScrollY = scrollY;
    ticking = false;
  }

  window.addEventListener('scroll', () => {
    if (!ticking) {
      window.requestAnimationFrame(updateHeader);
      ticking = true;
    }
  });

  // Mobile menu toggle
  menuToggle?.addEventListener('click', () => {
    const isActive = menuToggle.classList.toggle('is-active');
    mobileMenu.classList.toggle('is-open', isActive);
    document.body.style.overflow = isActive ? 'hidden' : '';
    
    menuToggle.setAttribute('aria-label', isActive ? 'メニューを閉じる' : 'メニューを開く');
  });

  // Close mobile menu on link click
  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      menuToggle.classList.remove('is-active');
      mobileMenu.classList.remove('is-open');
      document.body.style.overflow = '';
    });
  });
</script>
