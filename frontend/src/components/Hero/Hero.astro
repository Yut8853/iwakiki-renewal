  <div class={styles.heroTextInner}>

    <p class={styles.heroText}>Real Estate </p>
    <p class={styles.heroText} aria-hidden="true">Real Estate </p>
  </div>
</div>

<div class="l-container--news">
  <div class={styles.newsWrapper}>
    <p class={styles.infomation}>information</p>

  </div>
</div>
