---
import "../styles/global.scss";
import Header from "../components/Header/Header.astro";
import SidePanel from "../components/SidePanel.astro";
import { site, absoluteUrl, canonicalUrl as canonical, structuredData, serializeJsonLd, type Breadcrumb } from '../libs/seo';
interface Props {
  title?: string; description?: string; keywords?: string; ogImage?: string; ogType?: 'website' | 'article';
  canonicalUrl?: string; noIndex?: boolean; publishedTime?: string; modifiedTime?: string;
  author?: string; section?: string; articleTitle?: string; breadcrumbs?: Breadcrumb[];
  articleItems?: { title: string; url: string }[];
}
const {
  title = '株式会社iwakiki | いわき市の不動産売買・賃貸・管理', description = site.description,
  ogImage = site.image, ogType = 'website', canonicalUrl, noIndex = false,
  publishedTime, modifiedTime, author = site.name, section, articleTitle, breadcrumbs, articleItems = [],
} = Astro.props;
const siteName = site.name;
const currentUrl = canonical(canonicalUrl || Astro.url.pathname);
const fullOgImage = absoluteUrl(ogImage);
const blockIndex = noIndex || import.meta.env.PUBLIC_SITE_INDEXING === 'false';
const labels: Record<string, string> = { '/about/': '私たちについて', '/services/': 'サービス内容', '/blog/': 'お知らせ', '/contact/': 'お問い合わせ' };
const crumbs = breadcrumbs || [{ name: 'ホーム', path: '/' }, ...(Astro.url.pathname === '/' ? [] : [{ name: labels[new URL(currentUrl).pathname] || title.split(' | ')[0], path: currentUrl }])];
const schema = structuredData({ path: new URL(currentUrl).pathname, title, description, image: ogImage, breadcrumbs: crumbs,
  article: ogType === 'article' ? { title: articleTitle || title.split(' | ')[0], publishedAt: publishedTime || '', modifiedAt: modifiedTime, category: section || 'お知らせ' } : undefined,
  items: articleItems,
});
---

<html lang="ja">
  <head>
    <!-- 基本メタタグ -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    
    <!-- SEO メタタグ -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    {blockIndex && <meta name="robots" content="noindex, nofollow" />}
    {!blockIndex && <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}
    
    <!-- カノニカルURL -->
    <link rel="canonical" href={currentUrl} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullOgImage} />
    <meta property="og:image:alt" content={ogType === 'article' ? (articleTitle || title) : siteName} />
    {ogImage === site.image && <><meta property="og:image:width" content="1024" /><meta property="og:image:height" content="1024" /></>}
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="ja_JP" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {section && <meta property="article:section" content={section} />}
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={currentUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImage} />
    <meta name="twitter:image:alt" content={ogType === 'article' ? (articleTitle || title) : siteName} />
    
    <!-- ファビコン -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="msapplication-TileColor" content="#06756d" />
    <meta name="theme-color" content="#06756d" />
    
    <!-- 追加のSEOメタタグ -->
    <meta name="format-detection" content="telephone=no" />
    <meta name="geo.region" content="JP-07" />
    <meta name="geo.placename" content="いわき市" />
    
    <!-- Google Fonts プリコネクト -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    
    <!-- 構造化データ (JSON-LD) -->
    <script type="application/ld+json" set:html={serializeJsonLd(schema)} />
    <link rel="alternate" type="application/rss+xml" title="iwakikiからのお知らせ" href="/rss.xml" />
  </head>

  <body>
    <Header />

    <div id="main-content">
      <slot />
    </div>

    <SidePanel />
  </body>
</html>
