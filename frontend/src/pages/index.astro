---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero/Hero.astro';
import { ProjectionGridCanvas } from '../components/WebGL/ProjectionGridCanvas';
import HeroText from '../components/Contents/HeroText.astro';
import { BlogCard } from '../components/Blog/BlogCard';
import styles from '../components/Blog/Blog.module.scss';
import { supabase } from '../libs/supabase';

// 1. Markdown記事を取得し、日付順にソートして最新6件を抽出
const { data: allPosts, error } = await supabase
  .from('blogs')
  .select('*')
  .eq('published', true)
  .order('published_at', { ascending: false });

if (error) {
  console.error(error);
}

// 最新3件だけ
const posts = (allPosts ?? []).slice(0, 3);
---

<Layout 
  title="株式会社iwakiki | いわき市の不動産パートナー - 売買・賃貸・管理"
  description="福島県いわき市の不動産会社「株式会社iwakiki」。マイホーム購入、土地売却、賃貸物件、物件管理まで、お客様のニーズに寄り添ったサービスを提供。地域密着型の丁寧なサポートで、あなたの暮らしをサポートします。"
  keywords="いわき市,不動産,売買,賃貸,物件管理,マイホーム,土地,福島県,iwakiki,不動産会社"
  ogType="website"
>
  <section class="webgl-section">
    <ProjectionGridCanvas client:load />
    <Hero />
  </section>

  <section class={styles.latestPosts || 'latest-posts'}>
    <div class={styles.container || 'container'}>
      <div class="section-header">
        <div>
          <span class="label">Update</span>
          <h2>iwakikiからのお知らせ</h2>
        </div>
        <a href="/blog" class="view-all">View All posts</a>
      </div>

      <div class="posts-grid">
        {posts.map((post, i) => (
          <BlogCard 
            client:load 
            post={{...post.data, slug: post.slug}} 
            index={i} 
          />
        ))}
      </div>
    </div>
  </section>

  <HeroText />
</Layout>

<style lang="scss">
  .webgl-section {
    position: relative;
    width: 100%;
    height: 100vh;
    overflow: hidden;
    margin-bottom: clamp(80px, 15vh, 150px);
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 48px;
    padding: 0 20px;

    .label {
      font-size: 12px;
      font-weight: 600;
      color: #06756d;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      display: block;
      margin-bottom: 8px;
    }

    h2 {
      font-size: clamp(24px, 4vw, 32px);
      font-weight: 700;
      color: #1a1a1a;
      line-height: 1.2;
    }

    .view-all {
      color: #666;
      font-size: 14px;
      text-decoration: none;
      border-bottom: 1px solid #ccc;
      padding-bottom: 4px;
      transition: all 0.3s ease;

      &:hover {
        color: #c5a059;
        border-color: #c5a059;
        transform: translateX(5px);
      }
    }

    @media (max-width: 640px) {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
      margin-bottom: 32px;
    }
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 32px;
    padding: 0 20px;

    @media (max-width: 640px) {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }

  .latest-posts {
    padding: 100px 0;

    @media (max-width: 768px) {
      padding: 60px 0;
    }
  }

  @media (max-width: 768px) {
    .webgl-section {
      height: 80vh;
      margin-bottom: 60px;
    }
  }
</style>
