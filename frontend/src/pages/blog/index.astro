---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import BlogCard from '../../components/Blog/BlogCard';
import BlogSidebar from '../../components/Blog/BlogSidebar';


const allPosts = await getCollection('blog');
const phoneNumber = '0246-00-0000';
const telLink = 'tel:0246-00-0000';
const sortedPosts = allPosts.sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
);

const blogCategories = {
  news: { label: 'お知らせ', color: '#06756d' },
  column: { label: 'コラム', color: '#e67e22' },
  property: { label: '物件情報', color: '#3498db' },
  lifestyle: { label: '暮らし', color: '#9b59b6' },
} as const;
---

<Layout title="Blog & News | iwakiki">
  <main class="blog-page-root">
    
    <!-- =========================
        HEADER
    ========================= -->
    <header class="blog-header">
      <div class="container">
        <span class="sub-title">Journal</span>
        <h1 class="main-title">iwakikiからのお知らせ</h1>
      </div>
    </header>

    <!-- =========================
        CONTENT
    ========================= -->
    <section class="blog-content">
      <div class="container">

        <!-- FILTER -->
        <div class="filter-bar">
          <button class="filter-btn active" data-filter="all">All posts</button>
          {Object.entries(blogCategories).map(([key, value]) => (
            <button class="filter-btn" data-filter={key}>
              {value.label}
            </button>
          ))}
        </div>

        <div class="blog-layout">

          <!-- LEFT（記事） -->
          <div class="main">
            <div class="blog-grid" id="blog-grid">
              {sortedPosts.map((post, index) => (
                <div class="grid-item" data-category={post.data.category}>
                  <BlogCard
                    client:load
                    post={{ ...post.data, slug: post.slug }}
                    index={index}
                  />
                </div>
              ))}
            </div>
          </div>

          <!-- RIGHT（サイドバー） -->
         <BlogSidebar client:load posts={sortedPosts} categories={blogCategories} />

        </div>
      </div>
    </section>
<section class="cta" data-scroll-section id="contact">
      <div class="cta-bg"><div class="cta-pattern"></div><div class="cta-glow"></div></div>
      <div class="container">
        <div class="cta-content js-fade-up">
          <h2 class="cta-title">住まい探しのパートナーとして、<br />あなたの夢を叶えます。</h2>
          <p class="cta-lead">ご相談・お問い合わせはお気軽にどうぞ。<br />専門スタッフが丁寧に対応いたします。</p>
          <div class="cta-actions">
            <a href={telLink} class="cta-phone" data-magnetic>
              <span class="phone-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z" stroke-width="2"/></svg>
              </span>
              <span class="phone-number">{phoneNumber}</span>
            </a>
            <a href="#contact-form" class="cta-form" data-magnetic>
              <span>お問い合わせフォーム</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M5 12h14M12 5l7 7-7 7" stroke-width="2"/></svg>
            </a>
          </div>
          <div class="cta-info">
            <div class="info-item"><span>営業時間: 9:00 - 18:00（水曜定休）</span></div>
            <div class="info-item"><span>〒970-0000 福島県いわき市○○町1-2-3</span></div>
          </div>
        </div>
      </div>
    </section>
  </main>

</Layout>

<script>
  const setupFilters = () => {
    const filterBtns = document.querySelectorAll('.filter-btn');
    const items = document.querySelectorAll('.grid-item');

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');

        filterBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');

        items.forEach((item) => {
          const category = item.getAttribute('data-category');

          if (item instanceof HTMLElement) {
            if (filter === 'all' || category === filter) {
              item.style.display = 'block';
            } else {
              item.style.display = 'none';
            }
          }
        });
      });
    });
  };

  setupFilters();
  document.addEventListener('astro:after-swap', setupFilters);
</script>

<style lang="scss">
/* ここにCSSを記述します。
  ここより下に 「import ...」や「---」が混入していないか確認してください。
*/
.blog-page-root { background: #fff; min-height: 100vh; }
.container { max-width: 1200px; margin: 0 auto; padding: 0 20px; }

.blog-header {
  padding: 160px 0 80px;
  text-align: center;
  .sub-title { font-size: 12px; color: #06756d; letter-spacing: 0.2em; font-weight: 700; }
  .main-title { font-size: clamp(40px, 8vw, 64px); font-weight: 800; margin-top: 16px; }
}

.filter-bar {
  display: flex; justify-content: center; gap: 12px;
  margin-bottom: 60px; padding-bottom: 40px; border-bottom: 1px solid #f0f0f0;
}

.filter-btn {
  padding: 10px 24px; border-radius: 100px; font-weight: 700; color: #888;
  cursor: pointer; background: #f8f8f8; border: none;
  &.active { background: #111; color: #fff; }
}

.blog-layout { display: grid; grid-template-columns: 1fr 300px; gap: 60px; }
.main { min-width: 0; }
.blog-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 48px 32px; }

.sidebar {
  position: sticky; top: 120px;
  .sidebar-section {
    margin-bottom: 40px;
    h3 { font-size: 14px; font-weight: 700; margin-bottom: 12px; }
    ul { list-style: none; padding: 0; }
    a { font-size: 14px; color: #666; text-decoration: none; &:hover { color: #111; } }
  }
}

/* CONTACT CTA SECTION */
.cta {
  position: relative;
  padding: 120px 0;
  background-color: #06756d; // コーポレートカラーに合わせる
  color: #fff;
  overflow: hidden;
  margin-top: 100px;

  .cta-content {
    position: relative;
    z-index: 2;
    text-align: center;
  }

  .cta-title {
    font-size: clamp(24px, 4vw, 40px);
    font-weight: 700;
    line-height: 1.5;
    margin-bottom: 24px;
  }

  .cta-lead {
    font-size: 18px;
    opacity: 0.9;
    margin-bottom: 48px;
  }

  .cta-actions {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin-bottom: 60px;

    @media (max-width: 768px) {
      flex-direction: column;
      align-items: center;
    }
  }

  .cta-phone, .cta-form {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 20px 40px;
    border-radius: 100px;
    text-decoration: none;
    font-weight: 700;
    transition: all 0.3s ease;
    min-width: 280px;
  }

  .cta-phone {
    background: #fff;
    color: #06756d;
    .phone-icon svg { width: 20px; height: 20px; }
    .phone-number { font-size: 20px; }
  }

  .cta-form {
    background: transparent;
    border: 2px solid #fff;
    color: #fff;
    svg { width: 20px; height: 20px; }
    &:hover { background: #fff; color: #06756d; }
  }

  .cta-info {
    display: flex;
    justify-content: center;
    gap: 40px;
    font-size: 14px;
    opacity: 0.8;

    @media (max-width: 768px) {
      flex-direction: column;
      gap: 16px;
      align-items: flex-start;
      display: inline-block;
      text-align: left;
    }

    .info-item {
      display: flex;
      align-items: center;
      gap: 8px;
      svg { width: 18px; height: 18px; flex-shrink: 0; }
    }
  }

  /* 装飾用背景 */
  .cta-bg {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    pointer-events: none;
  }
}

@media (max-width: 768px) {
  .blog-layout { grid-template-columns: 1fr; }
  .sidebar { display: none; }
  .cta-actions { flex-direction: column; align-items: center; }
}
</style>