---
import Layout from '../../layouts/Layout.astro';
import BlogCard from '../../components/Blog/BlogCard';
import BlogSidebar from '../../components/Blog/BlogSidebar';
import Footer from '~/components/Footer/Footer.astro';
import { supabase } from '../../libs/supabase';

export const prerender = true;

// 🔥 Supabaseから取得
const { data: allPosts, error } = await supabase
  .from('blogs')
  .select('*')
  .eq('published', true)
  .order('published_at', { ascending: false });

if (error) {
  console.error(error);
}

const phoneNumber = '0246-00-0000';
const telLink = 'tel:0246-00-0000';

// null対策
const sortedPosts = allPosts ?? [];

const blogCategories = {
  news: { label: 'お知らせ', color: '#06756d' },
  column: { label: 'コラム', color: '#e67e22' },
  property: { label: '物件情報', color: '#3498db' },
  lifestyle: { label: '暮らし', color: '#9b59b6' },
};
---

<Layout 
  title="ブログ・お知らせ | 株式会社iwakiki - いわき市の不動産情報"
  description="株式会社iwakikiの最新情報をお届け。いわき市の不動産市場動向、物件情報、暮らしのコラム、会社からのお知らせなど、役立つ情報を発信しています。"
  keywords="いわき市,不動産ブログ,物件情報,お知らせ,コラム,暮らし,不動産市場,iwakiki"
  ogType="website"
>
  <main class="blog-page-root">
    
    <!-- =========================
        HEADER
    ========================= -->
    <header class="blog-header">
      <div class="container">
        <span class="sub-title">Journal</span>
        <h1 class="main-title">iwakikiからのお知らせ</h1>
      </div>
    </header>

    <!-- =========================
        CONTENT
    ========================= -->
    <section class="blog-content">
      <div class="container">

        <!-- FILTER -->
        <div class="filter-bar">
          <button class="filter-btn active" data-filter="all">All posts</button>
          {Object.entries(blogCategories).map(([key, value]) => (
            <button class="filter-btn" data-filter={key}>
              {value.label}
            </button>
          ))}
        </div>

        <div class="blog-layout">

          <!-- LEFT（記事） -->
          <div class="main">
            <div class="blog-grid" id="blog-grid">
              {sortedPosts.map((post, index) => (
                <div class="grid-item" data-category={post?.category ?? 'uncategorized'}>
                  <BlogCard
                    client:load
                    post={post}
                    index={index}
                  />
                </div>
              ))}
            </div>
          </div>

          <!-- RIGHT（サイドバー） -->
         <BlogSidebar client:load posts={sortedPosts} categories={blogCategories} />

        </div>
      </div>
    </section>
<Footer />
  </main>

</Layout>

<script>
  const setupFilters = () => {
    const filterBtns = document.querySelectorAll('.filter-btn');
    const items = document.querySelectorAll('.grid-item');

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');

        filterBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');

        items.forEach((item) => {
          const category = item.getAttribute('data-category');

          if (item instanceof HTMLElement) {
            if (filter === 'all' || category === filter) {
              item.style.display = 'block';
            } else {
              item.style.display = 'none';
            }
          }
        });
      });
    });
  };

  setupFilters();
  document.addEventListener('astro:after-swap', setupFilters);
</script>

<style lang="scss">
/* ここにCSSを記述します。
  ここより下に 「import ...」や「---」が混入していないか確認してください。
*/
.blog-page-root { background: #fff; min-height: 100vh; }
.container { max-width: 1200px; margin: 0 auto 100px; padding: 0 20px; }

.blog-header {
  padding: 160px 0 80px;
  text-align: center;
  .sub-title { font-size: 12px; color: #06756d; letter-spacing: 0.2em; font-weight: 700; }
  .main-title { font-size: clamp(40px, 8vw, 64px); font-weight: 800; margin-top: 16px; }

  @media (max-width: 768px) {
    padding: 120px 0 50px;
    .main-title { font-size: clamp(28px, 8vw, 40px); }
  }
}

.filter-bar {
  display: flex; justify-content: center; gap: 12px;
  margin-bottom: 60px; padding-bottom: 40px; border-bottom: 1px solid #f0f0f0;
  flex-wrap: wrap;

  @media (max-width: 768px) {
    gap: 8px;
    margin-bottom: 40px;
    padding-bottom: 24px;
  }
}

.filter-btn {
  padding: 10px 24px; border-radius: 100px; font-weight: 700; color: #888;
  cursor: pointer; background: #f8f8f8; border: none;
  transition: all 0.3s ease;
  &.active { background: #111; color: #fff; }
  &:hover:not(.active) { background: #eee; color: #c5a059; }

  @media (max-width: 768px) {
    padding: 8px 16px;
    font-size: 13px;
  }
}

.blog-layout { display: grid; grid-template-columns: 1fr 300px; gap: 60px; }
.main { min-width: 0; }
.blog-grid { 
  display: grid; 
  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); 
  gap: 48px 32px;

  @media (max-width: 768px) {
    grid-template-columns: 1fr;
    gap: 24px;
  }
}

.sidebar {
  position: sticky; top: 120px;
  .sidebar-section {
    margin-bottom: 40px;
    h3 { font-size: 14px; font-weight: 700; margin-bottom: 12px; }
    ul { list-style: none; padding: 0; }
    a { font-size: 14px; color: #666; text-decoration: none; &:hover { color: #111; } }
  }
}

/* CONTACT CTA SECTION */
.cta {
  position: relative;
  padding: 120px 0;
  background-color: #06756d; // コーポレートカラーに合わせる
  color: #fff;
  overflow: hidden;
  margin-top: 100px;

  .cta-content {
    position: relative;
    z-index: 2;
    text-align: center;
  }

  .cta-title {
    font-size: clamp(24px, 4vw, 40px);
    font-weight: 700;
    line-height: 1.5;
    margin-bottom: 24px;
  }

  .cta-lead {
    font-size: 18px;
    opacity: 0.9;
    margin-bottom: 48px;
  }

  .cta-actions {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin-bottom: 60px;

    @media (max-width: 768px) {
      flex-direction: column;
      align-items: center;
    }
  }

  .cta-phone, .cta-form {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 20px 40px;
    border-radius: 100px;
    text-decoration: none;
    font-weight: 700;
    transition: all 0.3s ease;
    min-width: 280px;
  }

  .cta-phone {
    background: #fff;
    color: #06756d;
    .phone-icon svg { width: 20px; height: 20px; }
    .phone-number { font-size: 20px; }
  }

  .cta-form {
    background: transparent;
    border: 2px solid #fff;
    color: #fff;
    svg { width: 20px; height: 20px; }
    &:hover { background: #fff; color: #06756d; }
  }

  .cta-info {
    display: flex;
    justify-content: center;
    gap: 40px;
    font-size: 14px;
    opacity: 0.8;

    @media (max-width: 768px) {
      flex-direction: column;
      gap: 16px;
      align-items: flex-start;
      display: inline-block;
      text-align: left;
    }

    .info-item {
      display: flex;
      align-items: center;
      gap: 8px;
      svg { width: 18px; height: 18px; flex-shrink: 0; }
    }
  }

  /* 装飾用背景 */
  .cta-bg {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    pointer-events: none;
  }
}

@media (max-width: 768px) {
  .blog-layout { grid-template-columns: 1fr; gap: 40px; }
  .sidebar { display: none; }
  .cta-actions { flex-direction: column; align-items: center; }
  .container { margin-bottom: 60px; }
  .cta { padding: 80px 0; margin-top: 60px; }
  .cta-phone, .cta-form { min-width: 100%; max-width: 300px; padding: 16px 24px; }
}
</style>
