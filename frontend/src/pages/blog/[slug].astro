---
import Layout from '../../layouts/Layout.astro';
import Footer from '~/components/Footer/Footer.astro';
import { supabase } from '../../libs/supabase';
import { marked } from 'marked';

export async function getStaticPaths() {
  const { data: posts, error } = await supabase
    .from('blogs')
    .select('slug')
    .eq('published', true);

  if (error) {
    console.error('getStaticPaths error:', error);
    return [];
  }

  return (posts ?? []).map((post) => ({
    params: { slug: post.slug },
  }));
}

const slug = Astro.params.slug;

const { data: post, error: postError } = await supabase
  .from('blogs')
  .select('*')
  .eq('slug', slug)
  .eq('published', true)
  .single();

if (postError || !post) {
  throw Astro.redirect('/404');
}

const { data: allPosts } = await supabase
  .from('blogs')
  .select('id, slug, title, description, featured_image, category, published_at')
  .eq('published', true)
  .neq('slug', post.slug)
  .order('published_at', { ascending: false })
  .limit(3);

const relatedPosts = allPosts ?? [];

const articleUrl = `/blog/${post.slug}`;
const articleImage = post.featured_image || '/blog/default.jpg';
const authorName = '福縁西不動産';
const authorRole = '地域密着の不動産サポート';
const authorAvatar = '/blog/default.jpg';

const publishedDate = post.published_at
  ? new Date(post.published_at)
  : new Date();

const contentHtml = marked.parse(post.content ?? '');
---

<Layout title={post.title}>
  <div class="progress" id="progress"></div>

  <section class="hero">
    <div class="hero-visual">
      <img src={articleImage} alt={post.title} />
      <div class="hero-overlay"></div>
    </div>

    <div class="hero-inner">
      <div class="hero-meta">
        <span class="category">{post.category || 'ブログ'}</span>
        <time datetime={publishedDate.toISOString()}>
          {publishedDate.toLocaleDateString('ja-JP', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </time>
      </div>

      <h1 class="hero-title">{post.title}</h1>

      {post.description && (
        <p class="hero-excerpt">{post.description}</p>
      )}
    </div>
  </section>

  <div class="page-wrap">
    <main class="article-column">
      <article class="article-card">
        <article class="prose" set:html={contentHtml} />

        <section class="article-cta">
          <div class="article-cta-inner">
            <p class="article-cta-label">CONTACT</p>
            <h2>住まいのこと、お気軽にご相談ください</h2>
            <p class="article-cta-text">
              売買・賃貸・住み替え・資産活用まで、
              地域密着で丁寧にサポートいたします。
            </p>
            <a href="/contact" class="article-cta-link">お問い合わせはこちら →</a>
          </div>
        </section>
      </article>

      <section class="related">
        <div class="section-heading">
          <p class="section-label">RELATED POSTS</p>
          <h2>関連記事</h2>
        </div>

        <div class="related-grid">
          {relatedPosts.map((p) => (
            <a href={`/blog/${p.slug}`} class="related-card">
              <div class="related-image">
                <img
                  src={p.featured_image || '/blog/default.jpg'}
                  alt={p.title}
                />
              </div>
              <div class="related-body">
                <span class="related-category">{p.category || 'ブログ'}</span>
                <p class="related-title">{p.title}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    </main>

    <aside class="sidebar">
      <div class="sidebar-sticky">
        <section class="sidebar-card toc-card">
          <p class="sidebar-eyebrow">CONTENTS</p>
          <h3 class="sidebar-title">目次</h3>
          <nav class="toc" id="toc" aria-label="記事目次"></nav>
        </section>

        <section class="sidebar-card banner-card">
          <p class="sidebar-eyebrow">SHARE HOUSE</p>
          <h3 class="sidebar-title">シェアハウス特集</h3>
          <p class="banner-text">
            暮らし方に合わせた住まいの選択肢もご案内しています。
          </p>

          <div class="banner-actions">
            <a href="/sharehouse" class="banner-link">詳しく見る</a>
            <button
              type="button"
              class="copy-button"
              id="copy-link-button"
              data-copy-url={articleUrl}
            >
              リンクをコピー
            </button>
          </div>

          <p class="copy-feedback" id="copy-feedback" aria-live="polite"></p>
        </section>

        <section class="sidebar-card author-card">
          <p class="sidebar-eyebrow">AUTHOR</p>
          <h3 class="sidebar-title">著者プロフィール</h3>

          <div class="author-head">
            <img
              src={authorAvatar}
              alt={authorName}
              class="author-avatar"
            />
            <div class="author-meta">
              <p class="author-name">{authorName}</p>
              <p class="author-role">{authorRole}</p>
            </div>
          </div>

          <p class="author-description">
            福島県いわき市を中心に、住まい探しや不動産に関する情報を
            分かりやすくお届けしています。地域密着だからこそ分かる視点で、
            暮らしに役立つ情報を発信しています。
          </p>
        </section>
      </div>
    </aside>
  </div>
  <Footer />
</Layout>

<script>
  const initArticlePage = () => {
    const progressEl = document.getElementById('progress');
    const tocEl = document.getElementById('toc');
    const copyButton = document.getElementById('copy-link-button');
    const copyFeedback = document.getElementById('copy-feedback');

    const headings = Array.from(
      document.querySelectorAll('.prose h2, .prose h3')
    );

    const updateProgress = () => {
      if (!progressEl) return;

      const scrollTop = window.scrollY;
      const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
      const progress = maxScroll > 0 ? (scrollTop / maxScroll) * 100 : 0;

      progressEl.style.width = `${progress}%`;
    };

    updateProgress();
    window.addEventListener('scroll', updateProgress, { passive: true });

    if (tocEl && headings.length > 0) {
      const links = [];

      headings.forEach((heading, index) => {
        const el = heading;

        if (!el.id) {
          el.id = `article-heading-${index + 1}`;
        }

        const link = document.createElement('a');
        link.href = `#${el.id}`;
        link.textContent = el.textContent || '';

        if (el.tagName.toLowerCase() === 'h3') {
          link.classList.add('is-sub');
        }

        tocEl.appendChild(link);
        links.push(link);
      });

      const updateActiveToc = () => {
        let currentIndex = 0;

        headings.forEach((heading, index) => {
          const rect = heading.getBoundingClientRect();

          if (rect.top <= 140) {
            currentIndex = index;
          }
        });

        links.forEach((link, index) => {
          link.classList.toggle('active', index === currentIndex);
        });
      };

      updateActiveToc();
      window.addEventListener('scroll', updateActiveToc, { passive: true });
    }

    if (copyButton) {
      copyButton.addEventListener('click', async () => {
        const url = copyButton.dataset.copyUrl || window.location.href;
        await navigator.clipboard.writeText(url);

        if (copyFeedback) {
          copyFeedback.textContent = 'コピーしました';
        }
      });
    }
  };

  initArticlePage();
  document.addEventListener('astro:after-swap', initArticlePage);
</script>

<style lang="scss">
  :root {
    --page-max: 1240px;
    --article-max: 760px;
    --sidebar-width: 320px;
    --text-main: #1f1f1f;
    --text-sub: #666;
    --line: #e9e9e9;
    --bg-soft: #f7f7f7;
    --accent: #111;
    --radius-lg: 20px;
    --radius-md: 14px;
    --shadow-soft: 0 10px 30px rgba(0, 0, 0, 0.06);
    --transition: 0.28s ease;
  }

  .page-wrap {
    margin-bottom: 100px;
  }

  .progress {
    position: fixed;
    top: 0;
    left: 0;
    height: 3px;
    width: 0;
    background: var(--accent);
    z-index: 9999;
  }

  .hero {
    position: relative;
    min-height: 48vh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: #111;
  }

  .hero-visual {
    position: absolute;
    inset: 0;
    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: brightness(0.55);
    }
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.62) 0%, rgba(0, 0, 0, 0.15) 45%, rgba(0, 0, 0, 0.08) 100%);
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 120px 24px 56px;
    color: #fff;
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 18px;
    align-items: center;
    margin-bottom: 18px;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.92;
  }

  .category {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 28px;
    padding: 0 12px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(6px);
    font-weight: 700;
  }

  .hero-title {
    max-width: 900px;
    margin: 0 0 18px;
    font-size: clamp(2rem, 4.6vw, 4.3rem);
    line-height: 1.12;
    letter-spacing: -0.03em;
    font-weight: 800;
  }

  .hero-excerpt {
    max-width: 760px;
    margin: 0;
    font-size: clamp(0.98rem, 1.8vw, 1.12rem);
    line-height: 1.9;
    color: rgba(255, 255, 255, 0.9);
  }

  .page-wrap {
    display: flex;
    gap: 56px;
    max-width: var(--page-max);
    margin: 72px auto 0;
    padding: 0 24px;
    align-items: flex-start !important; 
    overflow: visible !important;
  }

  .article-column {
    flex: 1;
    max-width: var(--article-max);
    margin-bottom: 100px;
  }

  .sidebar {
    width: var(--sidebar-width);
    flex-shrink: 0;
    height: auto !important;
    position: sticky;
    top: 150px;
  }

  .sidebar-sticky {
    position: sticky !important;
    top: 40px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    height: auto;
  }

  .sidebar-card {
    padding: 22px 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: #fff;
    box-shadow: var(--shadow-soft);
  }

  .sidebar-eyebrow {
    margin: 0 0 8px;
    font-size: 11px;
    letter-spacing: 0.12em;
    color: var(--text-sub);
    text-transform: uppercase;
    font-weight: 700;
  }

  .sidebar-title {
    margin: 0 0 16px;
    font-size: 1rem;
    line-height: 1.4;
    font-weight: 800;
    color: var(--text-main);
  }

  .toc {
    display: flex;
    flex-direction: column;
    gap: 10px;
    a {
      display: block;
      padding-left: 14px;
      border-left: 2px solid transparent;
      font-size: 13px;
      line-height: 1.6;
      color: var(--text-sub);
      text-decoration: none;
      transition: var(--transition);
      &:hover { color: var(--text-main); }
      &.active {
        border-left-color: var(--accent);
        color: var(--text-main);
        font-weight: 700;
      }
      &.is-sub {
        padding-left: 24px;
        font-size: 12px;
        opacity: 0.9;
      }
    }
  }

  .banner-card {
    background: linear-gradient(135deg, #111 0%, #2c2c2c 100%);
    color: #fff;
    border-color: transparent;
    .sidebar-eyebrow, .sidebar-title, .banner-text { color: #fff; }
  }

  .banner-text {
    margin: 0 0 16px;
    font-size: 14px;
    line-height: 1.8;
    opacity: 0.92;
  }

  .banner-actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .banner-link, .copy-button {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    min-height: 44px;
    padding: 0 14px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    transition: var(--transition);
  }

  .banner-link { background: #fff; color: #111; &:hover { transform: translateY(-1px); } }
  .copy-button {
    border: 1px solid rgba(255, 255, 255, 0.26);
    background: transparent;
    color: #fff;
    cursor: pointer;
    &:hover { background: rgba(255, 255, 255, 0.08); }
  }

  .author-head {
    display: flex;
    gap: 14px;
    align-items: center;
    margin-bottom: 14px;
  }
  .author-avatar { width: 62px; height: 62px; border-radius: 50%; object-fit: cover; }
  .author-name { margin: 0 0 4px; font-size: 15px; font-weight: 800; color: var(--text-main); }
  .author-role { margin: 0; font-size: 12px; color: var(--text-sub); }
  .author-description { margin: 0; font-size: 13px; line-height: 1.9; color: var(--text-sub); }

  .related {
    max-width: var(--page-max);
    margin: 96px auto 120px;
    padding: 0 24px;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .related-card {
    display: block;
    text-decoration: none;
    color: inherit;
    transition: var(--transition);
    &:hover { transform: translateY(-3px); }
  }

  .related-image {
    overflow: hidden;
    border-radius: 14px;
    aspect-ratio: 16 / 10;
    background: var(--bg-soft);
    img { width: 100%; height: 100%; object-fit: cover; transition: var(--transition); }
  }
  .related-card:hover .related-image img { transform: scale(1.04); }

  @media (max-width: 1024px) {
    .page-wrap {
      flex-direction: column;
      gap: 40px;
    }
    .sidebar {
      width: 100%;
    }
    .sidebar-sticky {
      position: static !important;
    }
    .related-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 768px) {
    .hero-title { font-size: clamp(1.9rem, 7vw, 2.8rem); }
    .page-wrap { margin-top: 48px; padding: 0 20px; }
    .related-grid { grid-template-columns: 1fr; }
  }

  :global(.prose) {
    color: var(--text-main);
    font-size: 17px;
    line-height: 2;

    p { margin-bottom: 28px; }
    h2 { margin: 88px 0 22px; font-size: clamp(1.6rem, 3vw, 2rem); font-weight: 800; }
    h3 { margin: 48px 0 16px; font-size: 1.25rem; font-weight: 700; }
    ul, ol { margin: 0 0 28px 1.5em; }
    li { margin-bottom: 8px; }
    img { width: 100%; border-radius: 16px; margin: 52px 0; }
    blockquote {
      margin: 32px 0;
      padding: 20px 24px;
      border-left: 4px solid var(--accent);
      background: var(--bg-soft);
      border-radius: 0 12px 12px 0;
    }
    a {
      color: inherit;
      text-decoration: underline;
      text-underline-offset: 3px;
    }
  }

  .article-card {
    background: #fff;
    border-radius: var(--radius-lg);
    padding: 40px;
    box-shadow: var(--shadow-soft);
  }

  .article-cta {
    margin-top: 56px;
    padding-top: 40px;
    border-top: 1px solid var(--line);
  }

  .article-cta-label {
    margin: 0 0 12px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--text-sub);
  }

  .article-cta-text {
    margin: 12px 0 20px;
    line-height: 1.9;
    color: var(--text-sub);
  }

  .article-cta-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 0 18px;
    border-radius: 999px;
    background: #111;
    color: #fff;
    text-decoration: none;
    font-weight: 700;
    transition: var(--transition);
    &:hover {
      transform: translateY(-1px);
    }
  }

  .section-heading {
    margin-bottom: 24px;
  }

  .section-label {
    margin: 0 0 8px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--text-sub);
  }

  .related-body {
    padding: 14px 4px 0;
  }

  .related-category {
    display: inline-block;
    margin-bottom: 8px;
    font-size: 12px;
    color: var(--text-sub);
  }

  .related-title {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    font-weight: 700;
    color: var(--text-main);
  }

  @media (max-width: 768px) {
    .article-card {
      padding: 24px 20px;
    }
  }
</style>