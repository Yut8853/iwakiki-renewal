---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer/Footer.astro';
import { getPublishedArticles } from '../../libs/blog-server';
import { articleHref, categoryLabel, formatDate, relatedArticles, type Article } from '../../libs/blog';
import { marked } from 'marked';

export async function getStaticPaths() {
  const { posts, unavailable } = await getPublishedArticles();
  if (unavailable) return [];
  return posts.map((post, index) => ({
    params: { slug: post.slug },
    props: { post, seoTitle: posts.some(p => p.slug !== post.slug && p.title === post.title) && post.publishedAt ? `${post.title}（${new Date(post.publishedAt).toLocaleDateString('ja-JP', {timeZone:'Asia/Tokyo',year:'numeric'})}）` : post.title, relatedPosts: relatedArticles(posts, post), newer: posts[index - 1] ?? null, older: posts[index + 1] ?? null },
  }));
}
interface Props { post: Article; seoTitle: string; relatedPosts: Article[]; newer: Article | null; older: Article | null }
const { post, seoTitle, relatedPosts, newer, older } = Astro.props;
const articleUrl = articleHref(post.slug);
const articleImage = post.image;
const authorName = '大澤 一仁';
const authorRole = '株式会社iwakiki 代表取締役';
const authorAvatar = '/images/IMG_1312.jpeg';
const contentHtml = await marked.parse(post.content);
---

<Layout title={`${seoTitle} | 株式会社iwakiki`} description={post.description || post.title} ogType="article" ogImage={articleImage} publishedTime={post.publishedAt || undefined} modifiedTime={post.modifiedAt} articleTitle={post.title} breadcrumbs={[{name:'ホーム',path:'/'},{name:'お知らせ',path:'/blog/'},{name:post.title,path:articleUrl}]} section={categoryLabel(post.category)} noIndex={Boolean(post.draft)}>
  <div class="progress" id="progress"></div>

  <section class="hero">
    <div class="hero-visual">
      <img src={articleImage} alt={post.title} fetchpriority="high" />
      <div class="hero-overlay"></div>
    </div>

    <div class="hero-inner">
      <nav class="article-breadcrumb" aria-label="パンくず"><a href="/">ホーム</a><span aria-hidden="true"> / </span><a href="/blog/">お知らせ</a><span aria-hidden="true"> / </span><span aria-current="page">{post.title}</span></nav>
      <div class="hero-meta">
        <a class="category" href={`/blog/?category=${encodeURIComponent(post.category)}`}>{categoryLabel(post.category)}</a>
        <time datetime={post.publishedAt || undefined}>{formatDate(post.publishedAt)}</time>
        <span>約{post.readingTime}分で読めます</span>
      </div>

      <h1 class="hero-title">{post.title}</h1>

      {post.description && (
        <p class="hero-excerpt">{post.description}</p>
      )}
    </div>
  </section>

  <div class="page-wrap">
    <main class="article-column">
      {post.draft && <aside class="draft-review"><strong>加筆案・公開前の確認用</strong><p>Excelの加筆案を反映した下書きです。元記事の掲載日時で整理しています。</p>{post.sourceUrl && <a href={post.sourceUrl} target="_blank" rel="noopener noreferrer">元記事を確認 ↗</a>}{post.reviewNotes?.length > 0 && <details><summary>確認メモ</summary><ul>{post.reviewNotes.map(note => <li>{note}</li>)}</ul></details>}</aside>}

      <article class="article-card">
        <div class="prose" id="article-body" set:html={contentHtml} />

        <section class="article-cta">
          <div class="article-cta-inner">
            <p class="article-cta-label">CONTACT</p>
            <h2>住まいのこと、お気軽にご相談ください</h2>
            <p class="article-cta-text">
              売買・賃貸・住み替え・資産活用まで、
              地域密着で丁寧にサポートいたします。
            </p>
            <a href="/contact" class="article-cta-link">お問い合わせはこちら →</a>
          </div>
        </section>
      </article>

      <nav class="article-navigation" aria-label="前後の記事">
        {newer && <a href={articleHref(newer.slug)}><span>← 新しい記事</span><strong>{newer.title}</strong></a>}
        {older && <a href={articleHref(older.slug)}><span>以前の記事 →</span><strong>{older.title}</strong></a>}
      </nav>
      <a class="back-to-list" href="/blog/">お知らせ一覧に戻る</a>
      {relatedPosts.length > 0 && <section class="related">
        <div class="section-heading">
          <p class="section-label">RELATED POSTS</p>
          <h2>関連記事</h2>
        </div>

        <div class="related-grid">
          {relatedPosts.map((p) => (
            <a href={articleHref(p.slug)} class="related-card">
              <div class="related-image">
                <img
                  src={p.image}
                  alt={p.title}
                />
              </div>
              <div class="related-body">
                <span class="related-category">{categoryLabel(p.category)}</span>
                <p class="related-title">{p.title}</p>
              </div>
            </a>
          ))}
        </div>
      </section>}
    </main>

    <aside class="sidebar">
      <div class="sidebar-sticky">
        <section class="sidebar-card toc-card" id="toc-card" hidden>
          <p class="sidebar-eyebrow">CONTENTS</p>
          <h3 class="sidebar-title">目次</h3>
          <nav class="toc" id="toc" aria-label="記事目次"></nav>
        </section>

        <section class="sidebar-card banner-card">
          <p class="sidebar-eyebrow">PROPERTY CONSULTATION</p>
          <h3 class="sidebar-title">空き家・相続のご相談</h3>
          <p class="banner-text">
            空き家や相続した不動産、別荘のことなど、お気軽にご相談ください。
          </p>

          <div class="banner-actions">
            <a href="/contact" class="banner-link">詳しく見る</a>
            <button
              type="button"
              class="copy-button"
              id="copy-link-button"
              data-copy-url={articleUrl}
            >
              リンクをコピー
            </button>
          </div>

          <p class="copy-feedback" id="copy-feedback" aria-live="polite"></p>
          <input id="copy-url-fallback" class="copy-url" type="text" readonly aria-label="共有する記事URL" hidden />
        </section>

        <section class="sidebar-card author-card">
          <p class="sidebar-eyebrow">AUTHOR</p>

          <div class="author-head">
            <div class="author-avatar">
              <img src={authorAvatar} alt={`代表取締役 ${authorName}`} loading="lazy" />
            </div>
            <div class="author-meta">
              <p class="author-name">{authorName}</p>
              <p class="author-role">{authorRole}</p>
            </div>
          </div>

          <p class="author-description">
            福島県いわき市を中心に、住まい探しや不動産に関する情報を
            分かりやすくお届けしています。地域密着だからこそ分かる視点で、
            暮らしに役立つ情報を発信しています。
          </p>
        </section>
      </div>
    </aside>
  </div>
  <Footer />
</Layout>

<script>
  let cleanup: (() => void) | undefined;
  const initArticlePage = () => {
    cleanup?.();
    const controller = new AbortController();
    const { signal } = controller;
    const body = document.getElementById('article-body');
    const progress = document.getElementById('progress');
    const toc = document.getElementById('toc');
    const tocCard = document.getElementById('toc-card');
    const copyButton = document.getElementById('copy-link-button');
    const feedback = document.getElementById('copy-feedback');
    const fallback = document.getElementById('copy-url-fallback') as HTMLInputElement | null;
    if (!body) return;
    const headings = Array.from(body.querySelectorAll<HTMLElement>('h2, h3'));
    const links: HTMLAnchorElement[] = [];
    toc?.replaceChildren();
    if (tocCard) tocCard.hidden = headings.length === 0;
    headings.forEach((el, index) => {
      if (!el.id) {
        let id = `article-heading-${index + 1}`;
        while (document.getElementById(id)) id += '-section';
        el.id = id;
      }
      const link = document.createElement('a');
      link.href = `#${encodeURIComponent(el.id)}`;
      link.textContent = el.textContent || '';
      link.classList.toggle('is-sub', el.tagName === 'H3');
      toc?.append(link); links.push(link);
    });
    let frame = 0;
    const update = () => {
      frame = 0;
      const rect = body.getBoundingClientRect();
      const distance = Math.max(1, body.offsetHeight - window.innerHeight + 140);
      const percent = Math.max(0, Math.min(100, (140 - rect.top) / distance * 100));
      if (progress) progress.style.width = `${percent}%`;
      let current = 0;
      headings.forEach((heading, i) => { if (heading.getBoundingClientRect().top <= 160) current = i; });
      links.forEach((link, i) => {
        link.classList.toggle('active', current === i);
        if (current === i) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
    };
    const schedule = () => { if (!frame) frame = requestAnimationFrame(update); };
    window.addEventListener('scroll', schedule, { passive: true, signal });
    window.addEventListener('resize', schedule, { passive: true, signal });
    update();
    copyButton?.addEventListener('click', async () => {
      const url = new URL(copyButton.dataset.copyUrl || window.location.pathname, window.location.origin).href;
      try {
        await navigator.clipboard.writeText(url);
        if (feedback) feedback.textContent = '記事のURLをコピーしました';
        if (fallback) fallback.hidden = true;
      } catch {
        if (feedback) feedback.textContent = '下のURLを選択してコピーしてください';
        if (fallback) { fallback.value = url; fallback.hidden = false; fallback.focus(); fallback.select(); }
      }
    }, { signal });
    cleanup = () => { controller.abort(); cancelAnimationFrame(frame); };
  };
  initArticlePage();
  document.addEventListener('astro:page-load', initArticlePage);
  document.addEventListener('astro:before-swap', () => cleanup?.());
</script>

<style lang="scss">
  :global(:root) {
    --page-max: 1240px;
    --article-max: 760px;
    --sidebar-width: 320px;
    --text-main: #1f1f1f;
    --text-sub: #666;
    --line: #e9e9e9;
    --bg-soft: #f7f7f7;
    --accent: #111;
    --radius-lg: 20px;
    --radius-md: 14px;
    --shadow-soft: 0 10px 30px rgba(0, 0, 0, 0.06);
    --transition: 0.28s ease;
  }

  .page-wrap {
    margin-bottom: 100px;
  }

  .progress {
    position: fixed;
    top: 0;
    left: 0;
    height: 3px;
    width: 0;
    background: var(--accent);
    z-index: 9999;
  }

  .hero {
    position: relative;
    min-height: 48vh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: #111;
  }

  .hero-visual {
    position: absolute;
    inset: 0;
    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: brightness(0.55);
    }
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.62) 0%, rgba(0, 0, 0, 0.15) 45%, rgba(0, 0, 0, 0.08) 100%);
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 120px 24px 56px;
    color: #fff;
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 18px;
    align-items: center;
    margin-bottom: 18px;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.92;
  }

  .category {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 28px;
    padding: 0 12px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(6px);
    font-weight: 700;
  }

  .hero-title {
    max-width: 900px;
    margin: 0 0 18px;
    font-size: clamp(2rem, 4.6vw, 4.3rem);
    line-height: 1.12;
    letter-spacing: -0.03em;
    font-weight: 800;
  }

  .hero-excerpt {
    max-width: 760px;
    margin: 0;
    font-size: clamp(0.98rem, 1.8vw, 1.12rem);
    line-height: 1.9;
    color: rgba(255, 255, 255, 0.9);
  }

  .page-wrap {
    display: flex;
    gap: 56px;
    max-width: var(--page-max);
    margin: 72px auto 0;
    padding: 0 24px;
    align-items: flex-start !important; 
    overflow: visible !important;
  }

  .article-column {
    flex: 1;
    max-width: var(--article-max);
    min-width: 0;
    margin-bottom: 100px;
  }

  .sidebar {
    width: var(--sidebar-width);
    flex-shrink: 0;
    height: auto !important;
    position: sticky;
    top: 150px;
  }

  .sidebar-sticky {
    position: sticky !important;
    top: 40px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    height: auto;
  }

  .sidebar-card {
    padding: 22px 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: #fff;
    box-shadow: var(--shadow-soft);
  }

  .sidebar-eyebrow {
    margin: 0 0 8px;
    font-size: 11px;
    letter-spacing: 0.12em;
    color: var(--text-sub);
    text-transform: uppercase;
    font-weight: 700;
  }

  .sidebar-title {
    margin: 0 0 16px;
    font-size: 1rem;
    line-height: 1.4;
    font-weight: 800;
    color: var(--text-main);
  }

  .toc {
    display: flex;
    flex-direction: column;
    gap: 10px;
    a {
      display: block;
      padding-left: 14px;
      border-left: 2px solid transparent;
      font-size: 13px;
      line-height: 1.6;
      color: var(--text-sub);
      text-decoration: none;
      transition: var(--transition);
      &:hover { color: var(--text-main); }
      &.active {
        border-left-color: var(--accent);
        color: var(--text-main);
        font-weight: 700;
      }
      &.is-sub {
        padding-left: 24px;
        font-size: 12px;
        opacity: 0.9;
      }
    }
  }

  .banner-card {
    background: linear-gradient(135deg, #111 0%, #2c2c2c 100%);
    color: #fff;
    border-color: transparent;
    .sidebar-eyebrow, .sidebar-title, .banner-text { color: #fff; }
  }

  .banner-text {
    margin: 0 0 16px;
    font-size: 14px;
    line-height: 1.8;
    opacity: 0.92;
  }

  .banner-actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .banner-link, .copy-button {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    min-height: 44px;
    padding: 0 14px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    transition: var(--transition);
  }

  .banner-link { background: #fff; color: #111; &:hover { transform: translateY(-1px); } }
  .copy-button {
    border: 1px solid rgba(255, 255, 255, 0.26);
    background: transparent;
    color: #fff;
    cursor: pointer;
    &:hover { background: rgba(255, 255, 255, 0.08); }
  }

  .author-head {
    display: flex;
    gap: 14px;
    align-items: center;
    margin-bottom: 14px;
  }
  .author-avatar { width: 72px; height: 72px; flex-shrink: 0; border-radius: 50%; overflow: hidden; }
  .author-avatar img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: center 40%; transform: scale(2.6); transform-origin: 35% 44%; }
  .author-name { margin: 0 0 4px; font-size: 15px; font-weight: 800; color: var(--text-main); }
  .author-role { margin: 0; font-size: 12px; color: var(--text-sub); }
  .author-description { margin: 0; font-size: 13px; line-height: 1.9; color: var(--text-sub); }

  .related {
    max-width: var(--page-max);
    margin: 96px auto 120px;
    padding: 0 24px;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .related-card {
    display: block;
    text-decoration: none;
    color: inherit;
    transition: var(--transition);
    &:hover { transform: translateY(-3px); }
  }

  .related-image {
    overflow: hidden;
    border-radius: 14px;
    aspect-ratio: 16 / 10;
    background: var(--bg-soft);
    img { width: 100%; height: 100%; object-fit: cover; transition: var(--transition); }
  }
  .related-card:hover .related-image img { transform: scale(1.04); }

  @media (max-width: 1024px) {
    .page-wrap {
      flex-direction: column;
      gap: 40px;
    }
    .sidebar {
      width: 100%;
    }
    .sidebar-sticky {
      position: static !important;
    }
    .related-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 768px) {
    .hero-title { font-size: clamp(1.9rem, 7vw, 2.8rem); }
    .page-wrap { margin-top: 48px; padding: 0 20px; }
    .related-grid { grid-template-columns: 1fr; }
  }

  :global(.prose) {
    color: var(--text-main);
    font-size: 17px;
    line-height: 2;

    p { margin-bottom: 28px; }
    h2 { margin: 88px 0 22px; font-size: clamp(1.6rem, 3vw, 2rem); font-weight: 800; }
    h3 { margin: 48px 0 16px; font-size: 1.25rem; font-weight: 700; }
    ul, ol { margin: 0 0 28px 1.5em; }
    li { margin-bottom: 8px; }
    img { display: block; max-width: 100%; width: auto; height: auto; border-radius: 16px; margin: 32px auto; }
    blockquote {
      margin: 32px 0;
      padding: 20px 24px;
      border-left: 4px solid var(--accent);
      background: var(--bg-soft);
      border-radius: 0 12px 12px 0;
    }
    a {
      color: inherit;
      text-decoration: underline;
      text-underline-offset: 3px;
    }
  }

  .article-card {
    background: #fff;
    border-radius: var(--radius-lg);
    padding: 40px;
    box-shadow: var(--shadow-soft);
  }

  .article-cta {
    margin-top: 56px;
    padding-top: 40px;
    border-top: 1px solid var(--line);
  }

  .article-cta-label {
    margin: 0 0 12px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--text-sub);
  }

  .article-cta-text {
    margin: 12px 0 20px;
    line-height: 1.9;
    color: var(--text-sub);
  }

  .article-cta-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 0 18px;
    border-radius: 999px;
    background: #111;
    color: #fff;
    text-decoration: none;
    font-weight: 700;
    transition: var(--transition);
    &:hover {
      transform: translateY(-1px);
    }
  }

  .section-heading {
    margin-bottom: 24px;
  }

  .section-label {
    margin: 0 0 8px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--text-sub);
  }

  .related-body {
    padding: 14px 4px 0;
  }

  .related-category {
    display: inline-block;
    margin-bottom: 8px;
    font-size: 12px;
    color: var(--text-sub);
  }

  .related-title {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    font-weight: 700;
    color: var(--text-main);
  }

  @media (max-width: 768px) {
    .article-card {
      padding: 24px 20px;
    }
  }
</style>
<style>
  .article-breadcrumb { font-size: 12px; line-height: 1.8; margin: 0 0 24px; overflow-wrap: anywhere; }
  .article-breadcrumb a, a.category { color: inherit; text-underline-offset: 4px; }
  .article-navigation { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; margin: 40px 0 24px; }
  .article-navigation a { border: 1px solid #e0e5df; border-radius: 12px; padding: 22px; color: #243c38; text-decoration: none; }
  .article-navigation span { display: block; color: #06756d; font-size: 12px; margin-bottom: 12px; }
  .article-navigation strong { font-size: 15px; line-height: 1.8; }
  .back-to-list { color: #06756d; text-underline-offset: 5px; }
  .copy-url { box-sizing: border-box; width: 100%; padding: 12px; border-radius: 6px; color: #222; background: white; border: 1px solid #ddd; }
  :global(.prose h2), :global(.prose h3) { scroll-margin-top: 140px; }
  :global(.prose pre) { overflow-x: auto; padding: 20px; background: #f4f5f0; border-radius: 8px; }
  :global(.prose table) { display: block; overflow-x: auto; border-collapse: collapse; }
  :global(.prose td), :global(.prose th) { padding: 12px; border: 1px solid #ddd; }
  :global(.prose) { overflow-wrap: anywhere; }
  @media(max-width:600px) { .article-navigation { grid-template-columns: 1fr; } }
</style>

<style>
.draft-review { background: #fff5dc; border: 1px solid #e0c98b; padding: 20px; border-radius: 12px; margin-bottom: 24px; font-size: 13px; line-height: 1.8; }
.draft-review a { color: #06756d; } .draft-review details { margin-top: 16px; } .draft-review ul { padding-left: 20px; white-space: pre-line; }
</style>
