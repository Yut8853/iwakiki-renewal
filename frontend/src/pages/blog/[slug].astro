---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');

  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const allPosts = await getCollection('blog');

const relatedPosts = allPosts
  .filter((p) => p.slug !== post.slug)
  .slice(0, 3);

const articleUrl = `/blog/${post.slug}`;
const articleImage = post.data.image || '/blog/default.jpg';
const authorName = post.data.author?.name || '福縁西不動産';
const authorRole = post.data.author?.role || '地域密着の不動産サポート';
const authorAvatar = post.data.author?.avatar || '/blog/default.jpg';
---

<Layout title={post.data.title}>
  <div class="progress" id="progress"></div>

  <section class="hero">
    <div class="hero-visual">
      <img src={articleImage} alt={post.data.title} />
      <div class="hero-overlay"></div>
    </div>

    <div class="hero-inner">
      <div class="hero-meta">
        <span class="category">{post.data.category}</span>
        <time datetime={post.data.publishedAt.toISOString()}>
          {post.data.publishedAt.toLocaleDateString('ja-JP', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </time>
        <span class="reading-time">{post.data.readingTime} min read</span>
      </div>

      <h1 class="hero-title">{post.data.title}</h1>

      {post.data.excerpt && (
        <p class="hero-excerpt">{post.data.excerpt}</p>
      )}
    </div>
  </section>

  <div class="page-wrap">
    <main class="article-column">
      <article class="article-card">
        <article class="prose">
          <Content />
        </article>

        {post.data.tags?.length > 0 && (
          <nav class="tags" aria-label="記事タグ">
            {post.data.tags.map((tag) => (
              <span class="tag">#{tag}</span>
            ))}
          </nav>
        )}

        <section class="article-cta">
          <div class="article-cta-inner">
            <p class="article-cta-label">CONTACT</p>
            <h2>住まいのこと、お気軽にご相談ください</h2>
            <p class="article-cta-text">
              売買・賃貸・住み替え・資産活用まで、
              地域密着で丁寧にサポートいたします。
            </p>
            <a href="/contact" class="article-cta-link">お問い合わせはこちら →</a>
          </div>
        </section>
      </article>

      <section class="related">
        <div class="section-heading">
          <p class="section-label">RELATED POSTS</p>
          <h2>関連記事</h2>
        </div>

        <div class="related-grid">
          {relatedPosts.map((p) => (
            <a href={`/blog/${p.slug}`} class="related-card">
              <div class="related-image">
                <img
                  src={p.data.image || '/blog/default.jpg'}
                  alt={p.data.title}
                />
              </div>
              <div class="related-body">
                <span class="related-category">{p.data.category}</span>
                <p class="related-title">{p.data.title}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    </main>

    <aside class="sidebar">
      <div class="sidebar-sticky">
        <section class="sidebar-card toc-card">
          <p class="sidebar-eyebrow">CONTENTS</p>
          <h3 class="sidebar-title">目次</h3>
          <nav class="toc" id="toc" aria-label="記事目次"></nav>
        </section>

        <section class="sidebar-card banner-card">
          <p class="sidebar-eyebrow">SHARE HOUSE</p>
          <h3 class="sidebar-title">シェアハウス特集</h3>
          <p class="banner-text">
            暮らし方に合わせた住まいの選択肢もご案内しています。
          </p>

          <div class="banner-actions">
            <a href="/sharehouse" class="banner-link">詳しく見る</a>
            <button
              type="button"
              class="copy-button"
              id="copy-link-button"
              data-copy-url={articleUrl}
            >
              リンクをコピー
            </button>
          </div>

          <p class="copy-feedback" id="copy-feedback" aria-live="polite"></p>
        </section>

        <section class="sidebar-card author-card">
          <p class="sidebar-eyebrow">AUTHOR</p>
          <h3 class="sidebar-title">著者プロフィール</h3>

          <div class="author-head">
            <img
              src={authorAvatar}
              alt={authorName}
              class="author-avatar"
            />
            <div class="author-meta">
              <p class="author-name">{authorName}</p>
              <p class="author-role">{authorRole}</p>
            </div>
          </div>

          <p class="author-description">
            福島県いわき市を中心に、住まい探しや不動産に関する情報を
            分かりやすくお届けしています。地域密着だからこそ分かる視点で、
            暮らしに役立つ情報を発信しています。
          </p>
        </section>
      </div>
    </aside>
  </div>
</Layout>

<script>
  const initArticlePage = () => {
    const progressEl = document.getElementById('progress');
    const tocEl = document.getElementById('toc');
    const copyButton = document.getElementById('copy-link-button');
    const copyFeedback = document.getElementById('copy-feedback');

    const headings = Array.from(
      document.querySelectorAll('.prose h2, .prose h3')
    );

    // =========================
    // progress bar
    // =========================
    const updateProgress = () => {
      if (!progressEl) return;

      const scrollTop = window.scrollY;
      const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
      const progress = maxScroll > 0 ? (scrollTop / maxScroll) * 100 : 0;

      progressEl.style.width = `${progress}%`;
    };

    updateProgress();
    window.addEventListener('scroll', updateProgress, { passive: true });

    // =========================
    // TOC（修正済）
    // =========================
    if (tocEl && headings.length > 0) {
      const links: HTMLAnchorElement[] = [];

      headings.forEach((heading, index) => {
        const el = heading;

        if (!el.id) {
          el.id = `article-heading-${index + 1}`;
        }

        const link = document.createElement('a');

        link.href = `#${el.id}`;
        link.textContent = el.textContent || '';

        if (el.tagName.toLowerCase() === 'h3') {
          link.classList.add('is-sub');
        }

        tocEl.appendChild(link);
        links.push(link);
      });

      const updateActiveToc = () => {
        let currentIndex = 0;

        headings.forEach((heading, index) => {
          const rect = heading.getBoundingClientRect();

          if (rect.top <= 140) {
            currentIndex = index;
          }
        });

        links.forEach((link, index) => {
          link.classList.toggle('active', index === currentIndex);
        });
      };

      updateActiveToc();
      window.addEventListener('scroll', updateActiveToc, { passive: true });
    }

    // =========================
    // copy
    // =========================
    if (copyButton) {
      copyButton.addEventListener('click', async () => {
        const url = copyButton.dataset.copyUrl || window.location.href;

        await navigator.clipboard.writeText(url);

        if (copyFeedback) {
          copyFeedback.textContent = 'コピーしました';
        }
      });
    }
  };

  initArticlePage();
  document.addEventListener('astro:after-swap', initArticlePage);
</script>

<style lang="scss">
  :root {
    --page-max: 1240px;
    --article-max: 760px;
    --sidebar-width: 320px;
    --text-main: #1f1f1f;
    --text-sub: #666;
    --line: #e9e9e9;
    --bg-soft: #f7f7f7;
    --accent: #111;
    --radius-lg: 20px;
    --radius-md: 14px;
    --shadow-soft: 0 10px 30px rgba(0, 0, 0, 0.06);
    --transition: 0.28s ease;
  }

  .progress {
    position: fixed;
    top: 0;
    left: 0;
    height: 3px;
    width: 0;
    background: var(--accent);
    z-index: 9999;
  }

  .hero {
    position: relative;
    min-height: 48vh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: #111;
  }

  .hero-visual {
    position: absolute;
    inset: 0;

    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: brightness(0.55);
    }
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgba(0, 0, 0, 0.62) 0%, rgba(0, 0, 0, 0.15) 45%, rgba(0, 0, 0, 0.08) 100%);
  }

  .hero-inner {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 120px 24px 56px;
    color: #fff;
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 18px;
    align-items: center;
    margin-bottom: 18px;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.92;
  }

  .category {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 28px;
    padding: 0 12px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(6px);
    font-weight: 700;
  }

  .hero-title {
    max-width: 900px;
    margin: 0 0 18px;
    font-size: clamp(2rem, 4.6vw, 4.3rem);
    line-height: 1.12;
    letter-spacing: -0.03em;
    font-weight: 800;
  }

  .hero-excerpt {
    max-width: 760px;
    margin: 0;
    font-size: clamp(0.98rem, 1.8vw, 1.12rem);
    line-height: 1.9;
    color: rgba(255, 255, 255, 0.9);
  }

.page-wrap {
display: flex;
  gap: 56px;
  max-width: var(--page-max);
  margin: 72px auto 0;
  padding: 0 24px;
  /* 重要：これがないとサイドバーが記事と同じ高さまで引き伸ばされ、
     中身が動く余白（レール）がなくなります */
  align-items: flex-start;
align-items: flex-start !important; 
  
  /* 【重要2】stickyの計算を阻害しないよう明示 */
  overflow: visible !important;
}


.article-column {
  flex: 1;
  max-width: var(--article-max);
}


  .article-card {
    min-width: 0;
  }

.sidebar {
  width: var(--sidebar-width);
  flex-shrink: 0;
  // height: 100%;
  height: auto !important;
  position: sticky;
  top: 150px;
}


  .sidebar-sticky {
    position: sticky !important;
    top: 40px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    height: auto;
  }

  .sidebar-card {
    padding: 22px 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: #fff;
    box-shadow: var(--shadow-soft);
  }

  .sidebar-eyebrow {
    margin: 0 0 8px;
    font-size: 11px;
    letter-spacing: 0.12em;
    color: var(--text-sub);
    text-transform: uppercase;
    font-weight: 700;
  }

  .sidebar-title {
    margin: 0 0 16px;
    font-size: 1rem;
    line-height: 1.4;
    font-weight: 800;
    color: var(--text-main);
  }

  .toc {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .toc a {
    display: block;
    padding-left: 14px;
    border-left: 2px solid transparent;
    font-size: 13px;
    line-height: 1.6;
    color: var(--text-sub);
    text-decoration: none;
    transition: var(--transition);
  }

  .toc a:hover {
    color: var(--text-main);
  }

  .toc a.active {
    border-left-color: var(--accent);
    color: var(--text-main);
    font-weight: 700;
  }

  .toc a.is-sub {
    padding-left: 24px;
    font-size: 12px;
    opacity: 0.9;
  }

  .toc-empty {
    margin: 0;
    font-size: 13px;
    color: var(--text-sub);
  }

  .banner-card {
    background: linear-gradient(135deg, #111 0%, #2c2c2c 100%);
    color: #fff;
    border-color: transparent;
  }

  .banner-card .sidebar-eyebrow,
  .banner-card .sidebar-title,
  .banner-card .banner-text {
    color: #fff;
  }

  .banner-text {
    margin: 0 0 16px;
    font-size: 14px;
    line-height: 1.8;
    opacity: 0.92;
  }

  .banner-actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .banner-link,
  .copy-button {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    min-height: 44px;
    padding: 0 14px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    transition: var(--transition);
  }

  .banner-link {
    background: #fff;
    color: #111;
  }

  .banner-link:hover {
    transform: translateY(-1px);
  }

  .copy-button {
    border: 1px solid rgba(255, 255, 255, 0.26);
    background: transparent;
    color: #fff;
    cursor: pointer;
  }

  .copy-button:hover {
    background: rgba(255, 255, 255, 0.08);
  }

  .copy-feedback {
    min-height: 1.4em;
    margin: 10px 0 0;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.82);
  }

  .author-head {
    display: flex;
    gap: 14px;
    align-items: center;
    margin-bottom: 14px;
  }

  .author-avatar {
    flex: 0 0 auto;
    width: 62px;
    height: 62px;
    border-radius: 50%;
    object-fit: cover;
  }

  .author-meta {
    min-width: 0;
  }

  .author-name {
    margin: 0 0 4px;
    font-size: 15px;
    font-weight: 800;
    color: var(--text-main);
  }

  .author-role {
    margin: 0;
    font-size: 12px;
    line-height: 1.6;
    color: var(--text-sub);
  }

  .author-description {
    margin: 0;
    font-size: 13px;
    line-height: 1.9;
    color: var(--text-sub);
  }

  .article-cta {
    margin-top: 64px;
  }

  .article-cta-inner {
    padding: 40px 32px;
    border-radius: var(--radius-lg);
    background: #111;
    color: #fff;
    text-align: center;
  }

  .article-cta-label {
    margin: 0 0 10px;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .article-cta-inner h2 {
    margin: 0 0 14px;
    font-size: clamp(1.35rem, 2.4vw, 1.9rem);
    line-height: 1.4;
  }

  .article-cta-text {
    margin: 0 0 20px;
    font-size: 14px;
    line-height: 1.9;
    color: rgba(255, 255, 255, 0.8);
  }

  .article-cta-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 20px;
    border-radius: 999px;
    background: #fff;
    color: #111;
    text-decoration: none;
    font-weight: 700;
  }

  .related {
    max-width: var(--page-max);
    margin: 96px auto 120px;
    padding: 0 24px;
  }

  .section-heading {
    margin-bottom: 28px;
  }

  .section-label {
    margin: 0 0 8px;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-sub);
    font-weight: 700;
  }

  .section-heading h2 {
    margin: 0;
    font-size: clamp(1.5rem, 2.8vw, 2rem);
    line-height: 1.3;
    color: var(--text-main);
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .related-card {
    display: block;
    text-decoration: none;
    color: inherit;
    transition: var(--transition);
  }

  .related-card:hover {
    transform: translateY(-3px);
  }

  .related-image {
    overflow: hidden;
    border-radius: 14px;
    aspect-ratio: 16 / 10;
    background: var(--bg-soft);
  }

  .related-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: var(--transition);
  }

  .related-card:hover .related-image img {
    transform: scale(1.04);
  }

  .related-body {
    padding-top: 12px;
  }

  .related-category {
    display: inline-block;
    margin-bottom: 8px;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-sub);
    font-weight: 700;
  }

  .related-title {
    margin: 0;
    font-size: 15px;
    line-height: 1.7;
    color: var(--text-main);
    font-weight: 700;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 40px;
  }

  .tag {
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    padding: 0 12px;
    border-radius: 999px;
    background: var(--bg-soft);
    color: var(--text-sub);
    font-size: 12px;
    font-weight: 700;
  }

  :global(.prose) {
    color: var(--text-main);
    font-size: 17px;
    line-height: 2;
    letter-spacing: 0.01em;
  }

  :global(.prose h2) {
    margin: 88px 0 22px;
    font-size: clamp(1.6rem, 3vw, 2rem);
    line-height: 1.4;
    font-weight: 800;
    color: var(--text-main);
  }

  :global(.prose h3) {
    margin: 48px 0 18px;
    font-size: 1.25rem;
    line-height: 1.5;
    font-weight: 800;
    color: var(--text-main);
  }

  :global(.prose p) {
    margin: 0 0 28px;
    color: #333;
  }

  :global(.prose img) {
    display: block;
    width: 100%;
    height: auto;
    margin: 52px 0;
    border-radius: 16px;
    box-shadow: var(--shadow-soft);
  }

  :global(.prose ul),
  :global(.prose ol) {
    margin: 28px 0;
    padding-left: 1.5em;
  }

  :global(.prose li) {
    margin-bottom: 10px;
  }

  :global(.prose blockquote) {
    margin: 40px 0;
    padding: 22px 24px;
    border-left: 4px solid #111;
    background: var(--bg-soft);
    border-radius: 0 12px 12px 0;
    color: #444;
  }

  :global(.prose a) {
    color: #111;
    text-decoration: underline;
    text-underline-offset: 0.14em;
  }

  :global(.prose hr) {
    margin: 48px 0;
    border: none;
    border-top: 1px solid var(--line);
  }

  @media (max-width: 1024px) {
  .page-wrap {
    flex-direction: column; /* ← これに変える */
    gap: 40px;
  }

    .sidebar-sticky {
      position: static;
    }

    .related-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 768px) {
    .hero {
      min-height: 54vh;
    }

    .hero-inner {
      padding: 100px 20px 36px;
    }

    .hero-title {
      font-size: clamp(1.9rem, 7vw, 2.8rem);
    }

    .page-wrap {
      margin-top: 48px;
      padding: 0 20px;
    }

    .sidebar {
      order: 2;
    }

    .article-column {
      order: 1;
    }

    .sidebar-sticky {
      gap: 16px;
    }

    .article-cta-inner {
      padding: 32px 22px;
    }

    .related {
      margin: 72px auto 88px;
      padding: 0 20px;
    }

    .related-grid {
      grid-template-columns: 1fr;
    }

    :global(.prose) {
      font-size: 16px;
      line-height: 1.95;
    }

    :global(.prose h2) {
      margin-top: 64px;
      font-size: 1.5rem;
    }

    :global(.prose img) {
      margin: 40px 0;
      border-radius: 12px;
    }
  }
</style>