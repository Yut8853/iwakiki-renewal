---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="私たちについて | 株式会社iwakiki - いわき市の不動産パートナー">
  <main class="about-page">
    <section class="hero">
      <div class="hero-bg">
        <video src="/videos/AdobeStock_564226647.mp4" autoplay loop muted playsinline></video>
        <div class="overlay"></div>
      </div>
      <div class="container hero-content">
        <span class="label animate-up">About iwakiki</span>
        <h1 class="animate-up">いわきの暮らしに、<br />新しい「風」を吹き込む。</h1>
      </div>
    </section>

    <section class="message section-padding">
      <div class="container grid-2">
        <div class="text-content animate-left">
          <span class="sub-label">Representative Message</span>
          <h2 class="section-title">お客様との<span>ご縁</span>を大切に<br />末永いお付き合いを</h2>
          
          <div class="story">
            <p>埼玉県で生まれ育ち、28歳で東京の不動産業界へ。都心を中心に約22年間、不動産と測量のプロフェッショナルとして、数多くのお客様の「住まい」と「資産」に向き合ってまいりました。</p>
            <p>その中で感じたのは、不動産取引は単なる物の売買ではなく、人との「ご縁」そのものだということです。お客様の喜びの声を力に、真心を込めたサービスを提供し続けることを、私の信念としております。</p>
            
            <blockquote class="highlight-text">
              「趣味のサーフィンが繋いだ、いわき市との縁。」
            </blockquote>
            
            <p>結婚を機に移住したここいわき市は、海と山が織りなす豊かな自然と、温かい人々に溢れています。この街の魅力にのめり込んだ私だからこそ、できることがあります。</p>
            <p>これまでの東京での経験（総合不動産、リノベーション、高齢者サポート）を活かし、いわき市の活性化、UIJターンの方々の架け橋となり、地域の皆様の暮らしがより豊かになるよう、誠心誠意お手伝いさせていただきます。</p>
          </div>
        </div>
        
        <div class="image-content animate-right">
          <div class="main-img">
            <img src="/images/IMG_1312.jpeg" alt="代表取締役 大澤一仁" />
            <div class="name-tag">
              <p class="en">Kazuhito Osawa</p>
              <p class="jp">代表取締役 大澤一仁</p>
            </div>
          </div>
          <div class="sub-img">
            <img src="/images/IMG_1304.jpeg" alt="iwakiki Office" />
          </div>
        </div>
      </div>
    </section>

    <section class="strengths section-padding dark">
      <div class="container">
        <div class="section-header text-center animate-up">
          <span class="sub-label">Our Promises</span>
          <h2 class="section-title">iwakikiの約束</h2>
        </div>
        
        <div class="grid-3">
          <div class="strength-card animate-up">
            <div class="icon"><i class="fas fa-handshake"></i></div>
            <h3>東京×いわきのハイブリッド視点</h3>
            <p>都心での22年の経験と、移住者としての新鮮な視点を融合。地元の良さを再発見し、広域からの移住もサポートします。</p>
          </div>
          
          <div class="strength-card animate-up" data-delay="1">
            <div class="icon"><i class="fas fa-home"></i></div>
            <h3>再生（リノベーション）のプロ</h3>
            <p>中古物件の価値を最大化するリノベーション事業を展開。空き家問題解決にも積極的に取り組み、新しい住まい方を提案します。</p>
          </div>
          
          <div class="strength-card animate-up" data-delay="2">
            <div class="icon"><i class="fas fa-heart"></i></div>
            <h3>地域密着の高齢者サポート</h3>
            <p>防災管理者、普通救命技能などの資格を活かし、単なる物件紹介に留まらない、安心して暮らせる地域づくりに貢献します。</p>
          </div>
        </div>
      </div>
    </section>

    <section class="profile section-padding">
      <div class="container">
        <div class="section-header animate-up">
          <span class="sub-label">Company Profile</span>
          <h2 class="section-title">会社概要</h2>
        </div>
        
        <div class="profile-grid animate-up">
          <div class="profile-item">
            <dt>商号</dt>
            <dd>株式会社ｉｗａｋｉｋｉ (イワキキ)</dd>
          </div>
          <div class="profile-item">
            <dt>所在地</dt>
            <dd>〒970-0224 福島県いわき市平豊間字合磯218-1</dd>
          </div>
          <div class="profile-item">
            <dt>代表取締役</dt>
            <dd>大澤 一仁</dd>
          </div>
          <div class="profile-item">
            <dt>資本金</dt>
            <dd>300万円</dd>
          </div>
          <div class="profile-item">
            <dt>事業内容</dt>
            <dd>不動産売買・賃貸仲介、買取・販売、再生(リノベーション)事業、管理事業、コンサルタント事業</dd>
          </div>
          <div class="profile-item">
            <dt>免許番号</dt>
            <dd>福島県知事（1）第3652号</dd>
          </div>
          <div class="profile-item full">
            <dt>保有資格</dt>
            <dd>宅地建物取引士、測量士、2級造園施工管理技士、防災管理者、普通救命技能</dd>
          </div>
          <div class="profile-item full">
            <dt>所属団体</dt>
            <dd>(公社)全日本不動産協会、(公社)不動産保証協会、(公財)東日本不動産流通機構</dd>
          </div>
        </div>
      </div>
    </section>

    <section class="instagram-banner">
      <a href="https://www.instagram.com/iwakiki.vacation.homes" target="_blank" rel="noopener noreferrer">
        <div class="content">
          <i class="fab fa-instagram"></i>
          <span>iwakiki vacation homes</span>
        </div>
        <img src="/images/iwakiki.vacation.homes.jpg" alt="iwakiki vacation homes" />
      </a>
    </section>
  </main>
</Layout>

<script>
  const obsOptions = {
    root: null,
    threshold: 0.15, // 15%ほど見えたら実行（早すぎず遅すぎず）
  };

  const obsCallback = function (entries: IntersectionObserverEntry[], observer: IntersectionObserver) {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        // 表示されたらactiveクラスを追加
        entry.target.classList.add('active');
        // 一度アニメーションしたら監視を解除（1回きり）
        observer.unobserve(entry.target);
      }
    });
  };

  // ページ読み込み完了時に実行
  window.addEventListener('DOMContentLoaded', () => {
    const observer = new IntersectionObserver(obsCallback, obsOptions);
    const targets = document.querySelectorAll('.animate-up, .animate-left, .animate-right');
    targets.forEach((target) => observer.observe(target));
  });
</script>

<style lang="scss">
  // --- Variables & Mixins (Layout.astroにあれば不要ですが、ここで定義) ---
  $color-primary: #06756d; // 既存のグリーン
  $color-dark: #1a1a1a;
  $color-text: #444;
  $color-bg-light: #fefcf8; // ベージュ系の軽い背景
  $font-en: 'Poppins', sans-serif;

  .about-page {
    color: $color-text;
    background-color: #fff;
    font-size: 16px;
    line-height: 1.8;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .section-padding {
    padding: 120px 0;
    @media (max-width: 768px) {
      padding: 80px 0;
    }
  }

  .section-title {
    font-size: clamp(28px, 4vw, 36px);
    font-weight: 700;
    color: $color-dark;
    line-height: 1.3;
    margin-bottom: 30px;
    span {
      color: $color-primary;
    }
  }

  .sub-label {
    font-size: 12px;
    font-family: $font-en;
    color: $color-primary;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    display: block;
    margin-bottom: 10px;
  }

  .grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
    @media (max-width: 968px) {
      grid-template-columns: 1fr;
      gap: 50px;
    }
  }

  .text-center { text-align: center; }

  // --- Animation Classes ---
  .animate-up, .animate-left, .animate-right {
    opacity: 0;
    transition: all 0.8s ease;
  }
  .animate-up { transform: translateY(40px); }
  .animate-left { transform: translateX(-40px); }
  .animate-right { transform: translateX(40px); }

  .active {
    opacity: 1;
    transform: translate(0, 0);
  }

  [data-delay="1"] { transition-delay: 0.2s; }
  [data-delay="2"] { transition-delay: 0.4s; }

  // --- 1. Hero ---
  .hero {
    position: relative;
    height: 80vh;
    display: flex;
    align-items: center;
    color: #fff;
    overflow: hidden;

    .hero-bg {
      position: absolute;
      inset: 0;
      z-index: 1;
      video {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      .overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, rgba(0,0,0,0.6) 0%, rgba(0,0,0,0.2) 100%);
      }
    }

    .hero-content {
      position: relative;
      z-index: 2;
      .label {
        font-family: $font-en;
        font-size: 14px;
        letter-spacing: 0.3em;
        text-transform: uppercase;
        margin-bottom: 20px;
        display: block;
      }
      h1 {
        font-size: clamp(36px, 6vw, 60px);
        font-weight: 700;
        line-height: 1.2;
      }
    }
  }

  // --- 2. Message ---
  .message {
    .story {
      p {
        margin-bottom: 1.5rem;
      }
      .highlight-text {
        font-size: 20px;
        font-weight: 600;
        color: $color-primary;
        margin: 40px 0;
        padding-left: 20px;
        border-left: 4px solid $color-primary;
      }
    }

    .image-content {
      position: relative;
      .main-img {
        position: relative;
        width: 90%;
        img {
          width: 100%;
          box-shadow: 0 30px 60px rgba(0,0,0,0.1);
        }
        .name-tag {
          position: absolute;
          bottom: -30px;
          right: -30px;
          background: $color-primary;
          color: #fff;
          padding: 20px 30px;
          box-shadow: 0 10px 30px rgba(0,0,0,0.2);
          .en { font-family: $font-en; font-size: 12px; letter-spacing: 0.1em; opacity: 0.8; }
          .jp { font-size: 18px; font-weight: 600; margin-top: 5px; }
        }
      }
      .sub-img {
        position: absolute;
        top: -20%;;
        right: -50%;
        width: 70%;
        z-index: -1;
        img {
          width: 100%;
          border: 10px solid #fff;
          box-shadow: 0 20px 40px rgba(0,0,0,0.1);
        }
      }
    }
  }

  // --- 3. Strengths ---
  .strengths {
    background-color: $color-dark;
    color: rgba(255,255,255,0.8);
    
    .section-title { color: #fff; }
    .sub-label { color: #fff; }

    .grid-3 {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 40px;
      margin-top: 80px;
      @media (max-width: 968px) {
        grid-template-columns: 1fr;
      }
    }

    .strength-card {
      background: rgba(255,255,255,0.05);
      padding: 50px;
      border-radius: 4px;
      border: 1px solid rgba(255,255,255,0.1);
      transition: all 0.3s ease;
      
      &:hover {
        background: rgba(255,255,255,0.1);
        transform: translateY(-10px);
      }

      .icon {
        font-size: 40px;
        color: $color-primary;
        margin-bottom: 30px;
      }
      h3 {
        font-size: 20px;
        font-weight: 600;
        color: #fff;
        margin-bottom: 20px;
      }
    }
  }

  // --- 4. Profile ---
  .profile {
    background-color: $color-bg-light;

    .profile-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 2px; // borderの代わり
      background-color: #eee;
      border: 2px solid #eee;
      margin-top: 60px;
      
      @media (max-width: 768px) {
        grid-template-columns: 1fr;
      }
    }

    .profile-item {
      display: flex;
      background-color: #fff;
      padding: 30px;
      
      @media (max-width: 640px) {
        flex-direction: column;
      }

      &.full {
        grid-column: span 2;
        @media (max-width: 768px) {
          grid-column: span 1;
        }
      }

      dt {
        width: 150px;
        font-weight: 700;
        color: $color-dark;
        flex-shrink: 0;
        @media (max-width: 640px) {
          width: 100%;
          margin-bottom: 8px;
        }
      }
      dd {
        margin: 0;
        flex: 1;
        color: $color-text;
      }
    }
  }

  // --- 5. Instagram ---
  .instagram-banner {
    a {
      display: block;
      position: relative;
      height: 300px;
      overflow: hidden;
      
      img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.6s ease;
      }

      .content {
        position: absolute;
        inset: 0;
        z-index: 2;
        background: rgba(0,0,0,0.4);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 24px;
        backdrop-filter: blur(2px);
        transition: all 0.3s ease;

        i { font-size: 48px; margin-bottom: 15px; }
        span { font-family: $font-en; letter-spacing: 0.1em; }
      }

      &:hover {
        img { transform: scale(1.1); }
        .content { background: rgba(6, 117, 109, 0.8); } // primary color
      }
    }
  }
</style>